// Prisma schema - Formation Matrice Evolution

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnrollmentStatus {
  paiement_en_attente
  paiement_confirme
  nda_envoye
  nda_signe
  teachizy_envoye
  rembourse
  acces_retire
}

/// État de la demande Yousign (indépendant du statut métier EnrollmentStatus).
enum YousignRequestStatus {
  ongoing
  done
  expired
  declined
  canceled
  rejected
  error
}

enum PaymentPlanId {
  unique
  x2
  x4
  x6
}

enum PaymentStatus {
  paid
  open
  failed
  void
  uncollectible
  draft
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  incomplete
  incomplete_expired
  trialing
  paused
  completed
}

model Enrollment {
  id        String           @id @default(cuid())
  email     String           @unique
  firstName String
  lastName  String
  status    EnrollmentStatus @default(paiement_en_attente)

  consentCgvAt     DateTime?
  consentNdaAt     DateTime?
  consentPrivacyAt DateTime?

  stripeCustomerId        String?
  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeSubscriptionId    String? @unique
  stripeScheduleId        String? @unique
  amountCents             Int     @default(184900)

  paymentPlan          PaymentPlanId?
  installmentsTotal    Int?
  installmentsPaid     Int                 @default(0)
  totalAmountCents     Int?
  collectedAmountCents Int                 @default(0)
  nextInstallmentDueAt DateTime?
  subscriptionStatus   SubscriptionStatus?

  yousignRequestId String?               @unique
  yousignSignerId  String?
  yousignStatus    YousignRequestStatus?
  ndaResendCount   Int                   @default(0)
  ndaResendDay     DateTime?
  ndaLastResendAt  DateTime?

  teachizyInvitedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       ProcessedEvent[]
  payments     Payment[]
  magicLinks   MagicLink[]
  adminActions AdminAction[]

  @@index([status])
  @@index([createdAt])
  @@index([subscriptionStatus])
  @@map("enrollments")
}

model Payment {
  id                    String        @id @default(cuid())
  enrollmentId          String
  enrollment            Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stripeInvoiceId       String?       @unique
  stripePaymentIntentId String?
  installmentNumber     Int
  amountCents           Int
  currency              String        @default("eur")
  status                PaymentStatus
  failureReason         String?
  invoicePdfUrl         String?
  hostedInvoiceUrl      String?
  invoicedAt            DateTime?
  paidAt                DateTime?
  dueAt                 DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([enrollmentId, installmentNumber])
  @@index([enrollmentId])
  @@index([status])
  @@index([dueAt])
  @@map("payments")
}

model ProcessedEvent {
  id                String      @id @default(cuid())
  provider          String
  eventId           String
  enrollmentId      String?
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  payloadCipherText String?
  createdAt         DateTime    @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
  @@index([enrollmentId])
  @@map("processed_events")
}

model MagicLink {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
  @@index([expiresAt])
  @@map("magic_links")
}

model AdminAction {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  adminEmail   String
  action       String
  meta         Json?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
  @@index([createdAt])
  @@map("admin_actions")
}
