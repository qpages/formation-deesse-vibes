// Prisma schema - Formation Matrice Evolution

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// État de l'encaissement, pas de chaque paiement, mais de l'ensemble des paiements.
enum CollectionStatus {
  pending
  current
  past_due
  paid
  canceled
  refunded
}

enum ContractStatus {
  pending
  sent
  signed
  expired
  declined
  canceled
  error
}

enum AccessStatus {
  not_eligible
  pending
  active
  suspended
  revoked
}

enum PaymentPlanId {
  unique
  x2
  x4
  x6
}

enum PaymentStatus {
  paid
  open
  failed
  void
  uncollectible
  draft
}

/// Miroir 1:1 de Stripe Subscription.status (pas de sémantique métier).
/// @see https://docs.stripe.com/api/subscriptions/object#subscription_object-status
enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum Provider {
  stripe
  yousign
  docuseal
}

enum SignatureProvider {
  yousign
  docuseal
}

enum SignKind {
  redirect
  embed
}

enum ProviderEventStatus {
  received
  processed
  ignored
  failed
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  firstName        String
  lastName         String
  stripeCustomerId String?  @unique
  teachizyUserId   String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments Enrollment[]

  @@map("users")
}

model Enrollment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  collectionStatus CollectionStatus @default(pending)
  contractStatus   ContractStatus   @default(pending)
  accessStatus     AccessStatus     @default(not_eligible)

  consentCgvAt                DateTime?
  consentNdaAt                DateTime?
  consentPrivacyAt            DateTime?
  consentWithdrawalWaiverAt   DateTime?

  currency             String              @default("eur")
  amountCents          Int                 @default(184900)
  paymentPlan          PaymentPlanId?
  installmentsTotal    Int?
  installmentsPaid     Int                 @default(0)
  totalAmountCents     Int?
  collectedAmountCents Int                 @default(0)
  firstPaymentPaidAt   DateTime?
  fullyPaidAt          DateTime?
  nextInstallmentDueAt DateTime?
  subscriptionStatus   SubscriptionStatus?
  /// Fin de période de facturation courante (min items[].current_period_end).
  currentPeriodEnd     DateTime?
  /// Fin prévue de l’abonnement (dernière phase du schedule ou cancel_at).
  subscriptionEndsAt   DateTime?
  /// Comportement du schedule à la fin (cancel | release).
  stripeScheduleEndBehavior String?

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeSubscriptionId    String? @unique
  stripeScheduleId        String? @unique

  signatureLinkExpiresAt DateTime?
  ndaNotifiedAt        DateTime?
  ndaLinkOpenedAt      DateTime?
  ndaSignedAt          DateTime?
  ndaDeliveryFailedAt  DateTime?
  ndaResendCount       Int                   @default(0)
  ndaResendDay         DateTime?
  ndaLastResendAt      DateTime?

  accessGrantedAt   DateTime?
  accessSuspendedAt DateTime?
  accessRevokedAt   DateTime?
  teachizyInvitedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events       ProviderEvent[]
  payments     Payment[]
  magicLinks   MagicLink[]
  adminActions AdminAction[]
  ndaRequest   NdaRequest?

  @@index([userId])
  @@index([collectionStatus])
  @@index([contractStatus])
  @@index([accessStatus])
  @@index([createdAt])
  @@index([subscriptionStatus])
  @@map("enrollments")
}

model Payment {
  id                    String        @id @default(cuid())
  enrollmentId          String
  enrollment            Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stripeInvoiceId       String?       @unique
  stripePaymentIntentId String?
  installmentNumber     Int
  amountCents           Int
  currency              String        @default("eur")
  status                PaymentStatus
  failureReason         String?
  invoicePdfUrl         String?
  hostedInvoiceUrl      String?
  invoicedAt            DateTime?
  paidAt                DateTime?
  dueAt                 DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([enrollmentId, installmentNumber])
  @@index([enrollmentId])
  @@index([status])
  @@index([dueAt])
  @@map("payments")
}

model ProviderEvent {
  id                String              @id @default(cuid())
  provider          Provider
  providerEventId   String
  eventType         String
  status            ProviderEventStatus @default(received)
  enrollmentId      String?
  enrollment        Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  payloadCipherText String?
  receivedAt        DateTime            @default(now())
  processedAt       DateTime?
  lastError         String?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([enrollmentId])
  @@map("provider_events")
}

model MagicLink {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
  @@index([expiresAt])
  @@map("magic_links")
}

model AdminAction {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  adminEmail   String
  action       String
  meta         Json?
  createdAt    DateTime   @default(now())

  @@index([enrollmentId])
  @@index([createdAt])
  @@map("admin_actions")
}

model NdaRequest {
  id                String            @id @default(cuid())
  enrollmentId      String            @unique
  enrollment        Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  provider          SignatureProvider
  externalRequestId String
  externalSignerId  String?
  signKind          SignKind          @default(redirect)
  providerStatus    String?
  lastError         String?
  lastErrorAt       DateTime?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([provider, externalRequestId])
  @@index([enrollmentId])
  @@map("nda_requests")
}
