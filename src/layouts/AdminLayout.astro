---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Toast from '../components/ui/Toast.astro';

interface Props {
	title?: string;
	email?: string;
}

const { title = 'Admin — Formation', email } = Astro.props;
const path = Astro.url.pathname;
const onList = path === '/admin' || path.startsWith('/admin?');
---

<BaseLayout title={title} noindex={true}>
	<div class="flex min-h-screen flex-col bg-mist/30">
		<header class="sticky top-0 z-20 border-b border-ink/10 bg-ink text-mist">
			<Container class="flex h-14 items-center justify-between gap-4">
				<div class="flex min-w-0 items-center gap-6">
					<a href="/admin" class="shrink-0 font-display text-lg tracking-wide text-mist">
						Admin
					</a>
					<nav class="flex items-center gap-4" aria-label="Admin">
						<a
							href="/admin"
							class:list={[
								'text-[11px] uppercase tracking-[0.16em] transition-colors',
								onList || path.startsWith('/admin/enrollments')
									? 'text-mist'
									: 'text-mist/55 hover:text-mist',
							]}
							aria-current={onList || path.startsWith('/admin/enrollments') ? 'page' : undefined}
						>
							Inscriptions
						</a>
					</nav>
				</div>

				{
					email && (
						<form method="post" action="/api/admin/logout" class="flex items-center gap-3">
							<span
								class="hidden max-w-[14rem] truncate text-[12px] text-mist/55 md:inline"
								title={email}
							>
								{email}
							</span>
							<button
								type="submit"
								class="shrink-0 border border-mist/25 px-3 py-1.5 text-[11px] uppercase tracking-[0.14em] text-mist/85 transition-colors hover:border-mist/50 hover:text-mist"
								onclick="event.preventDefault(); fetch('/api/admin/logout',{method:'POST'}).then(()=>location.href='/admin/login')"
							>
								Déconnexion
							</button>
						</form>
					)
				}
			</Container>
		</header>
		<main class="flex-1">
			<div class="py-8">
				<Container class="max-w-7xl">
					<slot />
				</Container>
			</div>
		</main>
	</div>
	<Toast />
</BaseLayout>
