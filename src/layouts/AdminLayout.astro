---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Toast from '../components/ui/Toast.astro';

interface Props {
	title?: string;
	email?: string;
}

const { title = 'Admin — Formation', email } = Astro.props;
const path = Astro.url.pathname;
const inscriptionsActive =
	path.startsWith('/admin/inscriptions') || path.startsWith('/admin/enrollments');
const learnersActive = path.startsWith('/admin/apprenants');
const faqActive = path.startsWith('/admin/faq');

function navLinkClass(active: boolean) {
	return active
		? 'inline-flex min-h-11 items-center px-2.5 text-mist'
		: 'inline-flex min-h-11 items-center px-2.5 text-mist/55 transition-colors hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold';
}
---

<BaseLayout title={title} noindex={true}>
	<div class="flex min-h-screen flex-col bg-mist/30">
		<header class="sticky top-0 z-20 border-b border-ink/10 bg-ink text-mist">
			<Container class="flex flex-wrap items-center justify-between gap-x-4 gap-y-0 py-1 sm:h-14 sm:flex-nowrap sm:py-0">
				<a
					href="/"
					class="inline-flex min-h-11 shrink-0 items-center font-display text-xl tracking-wide text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold sm:text-2xl"
				>
					Déesse Vibes
				</a>
				{
					email && (
						<form
							method="post"
							action="/api/admin/logout"
							class="ml-auto flex shrink-0 items-center gap-3 sm:order-last sm:ml-0"
						>
							<span
								class="hidden max-w-56 truncate text-xs text-mist/55 lg:inline"
								title={email}
							>
								{email}
							</span>
							<button
								type="submit"
								class="inline-flex min-h-11 items-center border border-mist/25 px-3 text-xs uppercase tracking-[0.14em] text-mist/85 transition-colors hover:border-mist/50 hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
								onclick="event.preventDefault(); fetch('/api/admin/logout',{method:'POST'}).then(()=>location.href='/admin/login')"
							>
								Déconnexion
							</button>
						</form>
					)
				}
				{
					email && (
						<nav
							class="-mx-2 flex w-[calc(100%+1rem)] min-w-0 items-center gap-0.5 overflow-x-auto text-xs uppercase tracking-[0.14em] sm:mx-0 sm:w-auto sm:flex-1"
							aria-label="Admin"
						>
							<a
								href="/admin/inscriptions"
								class={navLinkClass(inscriptionsActive)}
								aria-current={inscriptionsActive ? 'page' : undefined}
							>
								Inscriptions
							</a>
							<a
								href="/admin/apprenants"
								class={navLinkClass(learnersActive)}
								aria-current={learnersActive ? 'page' : undefined}
							>
								Apprenants
							</a>
							<a
								href="/admin/faq"
								class={navLinkClass(faqActive)}
								aria-current={faqActive ? 'page' : undefined}
							>
								FAQ
							</a>
						</nav>
					)
				}
			</Container>
		</header>
		<main class="flex-1">
			<div class="py-8">
				<Container class="max-w-7xl">
					<slot />
				</Container>
			</div>
		</main>
	</div>
	<Toast />
</BaseLayout>
