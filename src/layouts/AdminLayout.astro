---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Toast from '../components/ui/Toast.astro';

interface Props {
	title?: string;
	email?: string;
}

const { title = 'Admin — Formation', email } = Astro.props;
---

<BaseLayout title={title} noindex={true}>
	<div class="flex min-h-screen flex-col bg-mist/30">
		<header class="sticky top-0 z-20 border-b border-ink/10 bg-ink text-mist">
			<Container class="flex h-14 items-center justify-between gap-4">
				<a
					href="/"
					class="shrink-0 font-display text-xl tracking-wide text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold sm:text-2xl"
				>
					Déesse Vibes
				</a>

				{
					email && (
						<form method="post" action="/api/admin/logout" class="flex shrink-0 items-center gap-3">
							<span
								class="hidden max-w-[14rem] truncate text-xs text-mist/55 md:inline"
								title={email}
							>
								{email}
							</span>
							<button
								type="submit"
								class="border border-mist/25 px-3 py-1.5 text-xs uppercase tracking-[0.14em] text-mist/85 transition-colors hover:border-mist/50 hover:text-mist focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
								onclick="event.preventDefault(); fetch('/api/admin/logout',{method:'POST'}).then(()=>location.href='/admin/login')"
							>
								Déconnexion
							</button>
						</form>
					)
				}
			</Container>
		</header>
		<main class="flex-1">
			<div class="py-8">
				<Container class="max-w-7xl">
					<slot />
				</Container>
			</div>
		</main>
	</div>
	<Toast />
</BaseLayout>
