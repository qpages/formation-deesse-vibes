---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Toast from '../components/ui/Toast.astro';
import { isDev } from '../lib/env';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
	<div class="flex min-h-screen flex-col">
		<header class="animate-fade absolute inset-x-0 top-0 z-20">
			<Container class="flex items-center justify-between py-6">
				<a href="/" class="font-display text-mist text-xl tracking-wide sm:text-2xl">
					Déesse Vibes
				</a>
				<nav class="flex items-center gap-4 sm:gap-6" aria-label="Navigation">
					<a href="/" class="text-mist/70 hover:text-mist text-[11px] tracking-[0.2em] uppercase">
						Formation
					</a>
					{
						isDev && (
							<a
								href="/admin"
								class="text-mist/70 hover:text-mist text-[11px] tracking-[0.2em] uppercase"
							>
								Admin
							</a>
						)
					}
				</nav>
			</Container>
		</header>
		<Toast />
		<main class="flex-1">
			<slot />
		</main>
		<footer class="border-ink/10 border-t py-10">
			<Container
				class="text-ink-soft flex flex-col gap-3 text-sm sm:flex-row sm:items-center sm:justify-between"
			>
				<p>© {new Date().getFullYear()} Déesse Vibes — Formation Matrice Évolution</p>
				<div class="flex gap-5">
					<a href="/#programme" class="hover:text-ink">Programme</a>
					<a href="/#faq" class="hover:text-ink">FAQ</a>
					<a href="/mentions-legales" class="hover:text-ink">Mentions légales</a>
					<a href="/confidentialite" class="hover:text-ink">Confidentialité</a>
				</div>
			</Container>
		</footer>
	</div>
</BaseLayout>
