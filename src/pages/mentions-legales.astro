---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import BackLink from '../components/ui/BackLink.astro';
---

<MarketingLayout title="Mentions légales — Déesse Vibes">
	<div class="h-24 bg-ink"></div>
	<Container class="pt-8 sm:pt-10">
		<BackLink />
	</Container>
	<Section title="Mentions légales">
		<div class="max-w-2xl space-y-4 text-sm leading-relaxed text-ink-soft">
			<p>Éditeur : Déesse Vibes — à compléter (raison sociale, SIRET, adresse, contact).</p>
			<p>Hébergement : Vercel Inc.</p>
			<p>Contact formation : formation@deesse-vibes.com</p>
			<p class="text-xs text-ink/50">Brouillon — à finaliser avant production.</p>
		</div>
	</Section>
</MarketingLayout>
