---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Dialog from '../../../components/ui/Dialog.astro';
import StatusBadge from '../../../components/ui/StatusBadge.astro';
import ExternalLinks from '../../../components/admin/ExternalLinks.astro';
import PaymentPanel from '../../../components/admin/PaymentPanel.astro';
import AuditTimeline from '../../../components/admin/AuditTimeline.astro';
import EnrollmentRowActions from '../../../components/admin/EnrollmentRowActions.astro';
import { requireAdminPage } from '../../../lib/admin/auth';
import { getAdminEnrollmentDetail } from '../../../lib/admin/enrollments';
import { adminActionMetaForClient } from '../../../lib/admin/actions';
import { getAdminPaymentSummary } from '../../../lib/admin/payments';

export const prerender = false;

const admin = await requireAdminPage(Astro);
if (admin instanceof Response) return admin;

const id = Astro.params.id;
if (!id) return Astro.redirect('/admin');

const detail = await getAdminEnrollmentDetail(id);
if (!detail) return Astro.redirect('/admin');

const paymentSummary =
	(await getAdminPaymentSummary(id)) ?? detail.paymentSummary;
const actionMeta = adminActionMetaForClient();
---

<AdminLayout title={`${detail.displayName} — Admin`} email={admin}>
	<div class="mb-6">
		<a href="/admin" class="text-sm text-ink-soft underline underline-offset-2 hover:text-ink">
			← Inscriptions
		</a>
		<div class="mt-4 flex flex-wrap items-start justify-between gap-4">
			<div>
				<h1 class="font-display text-4xl text-ink">{detail.displayName}</h1>
				<p class="mt-1 text-ink-soft">{detail.email}</p>
				<p class="mt-2 text-[12px] text-ink/45">
					Créé le{' '}
					{detail.createdAt.toLocaleString('fr-FR', {
						dateStyle: 'short',
						timeStyle: 'short',
					})}
				</p>
			</div>
			<ExternalLinks stripeUrl={detail.stripeUrl} yousignUrl={detail.yousignUrl} />
		</div>
	</div>

	<section class="mb-8 grid gap-4 md:grid-cols-3">
		<div class="border border-ink/10 bg-white/60 p-4">
			<p class="text-[10px] uppercase tracking-[0.12em] text-ink/45">Paiement</p>
			<div class="mt-2">
				<StatusBadge tone={detail.paymentSummary.trackingTone}>
					{detail.paymentSummary.trackingLabel}
				</StatusBadge>
				<p class="mt-2 text-[11px] text-ink/45">{detail.paymentSummary.planLabel}</p>
			</div>
		</div>
		<div class="border border-ink/10 bg-white/60 p-4">
			<p class="text-[10px] uppercase tracking-[0.12em] text-ink/45">Signature</p>
			<div class="mt-2">
				<StatusBadge tone={detail.pipeline.signature.tone}>
					{detail.pipeline.signature.label}
				</StatusBadge>
			</div>
		</div>
		<div class="border border-ink/10 bg-white/60 p-4">
			<p class="text-[10px] uppercase tracking-[0.12em] text-ink/45">Accès</p>
			<div class="mt-2">
				<StatusBadge tone={detail.pipeline.acces.tone}>
					{detail.pipeline.acces.label}
				</StatusBadge>
			</div>
		</div>
	</section>

	<section class="mb-8 border border-ink/10 bg-white/60 p-4">
		<h2 class="font-display text-2xl text-ink">Actions</h2>
		<div class="mt-4">
			<EnrollmentRowActions row={detail} compact={false} />
		</div>
	</section>

	<div class="mb-8 border border-ink/10 bg-white/60 p-4">
		<PaymentPanel summary={paymentSummary} heading="Paiements" />
	</div>

	<div class="mb-8">
		<AuditTimeline items={detail.audit} />
	</div>

	<Dialog id="admin-action-dialog" title="Confirmer l’action">
		<Button slot="footer" type="button" variant="secondary" size="sm" id="admin-dialog-cancel">
			Annuler
		</Button>
		<Button slot="footer" type="button" variant="primary" size="sm" id="admin-dialog-confirm">
			Confirmer
		</Button>
	</Dialog>
</AdminLayout>

<script
	id="admin-action-meta"
	type="application/json"
	set:html={JSON.stringify(actionMeta)}
/>
<script>
	import { bindAdminActions } from '../../../components/admin/admin-client';
	import type { AdminActionMetaClient } from '../../../lib/admin/actions';

	const el = document.getElementById('admin-action-meta');
	if (el?.textContent) {
		bindAdminActions(JSON.parse(el.textContent) as AdminActionMetaClient);
	}
</script>
