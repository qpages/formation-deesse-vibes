---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';
import Dialog from '../../../components/ui/Dialog.astro';
import EnrollmentHeader from '../../../components/admin/detail/EnrollmentHeader.astro';
import PaymentPanel from '../../../components/admin/detail/PaymentPanel.astro';
import AuditTimeline from '../../../components/admin/detail/AuditTimeline.astro';
import EnrollmentPipeline from '../../../components/admin/detail/EnrollmentPipeline.astro';
import EnrollmentActionPanel from '../../../components/admin/detail/EnrollmentActionPanel.astro';
import EnrollmentAccessPanel from '../../../components/admin/detail/EnrollmentAccessPanel.astro';
import SignaturePanel from '../../../components/admin/detail/SignaturePanel.astro';
import { requireAdminPage } from '../../../lib/admin/auth';
import { getAdminEnrollmentDetail } from '../../../lib/admin/enrollments';
import { getAdminTeachizyLearner } from '../../../lib/admin/teachizy-learners';
import { adminActionMetaForClient, partitionVisibleActions } from '../../../lib/admin/actions';
import { getAdminPaymentSummary } from '../../../lib/admin/payments';
import { buildPipelineStageCards, enrollmentHeadline } from '../../../lib/admin/pipeline-detail';

export const prerender = false;

const admin = await requireAdminPage(Astro);
if (admin instanceof Response) return admin;

const id = Astro.params.id;
if (!id) return Astro.redirect('/admin/inscriptions');

const detail = await getAdminEnrollmentDetail(id);
if (!detail) return Astro.redirect('/admin/inscriptions');

const paymentSummary = (await getAdminPaymentSummary(id)) ?? detail.paymentSummary;
const actionMeta = adminActionMetaForClient();
const actionPartition = partitionVisibleActions(detail);
const pipelineStages = buildPipelineStageCards(detail, paymentSummary);
const headline = enrollmentHeadline(detail);
const teachizy = await getAdminTeachizyLearner(detail.email, detail.id);
---

<AdminLayout title={`${detail.displayName} — Admin`} email={admin}>
	<div id="enrollment-detail" data-enrollment-detail>
		<EnrollmentHeader
			displayName={detail.displayName}
			email={detail.email}
			enrollmentId={detail.id}
			createdAt={detail.createdAt}
			headline={headline}
		/>

		<EnrollmentPipeline stages={pipelineStages} />

		<PaymentPanel summary={paymentSummary} heading="Paiements" />

		<SignaturePanel
			detail={detail}
			enrollmentId={detail.id}
			displayName={detail.displayName}
			actions={actionPartition.signature}
		/>

		<EnrollmentAccessPanel
			detail={detail}
			enrollmentId={detail.id}
			displayName={detail.displayName}
			teachizy={teachizy}
			actions={actionPartition.access}
		/>

		<EnrollmentActionPanel
			enrollmentId={detail.id}
			displayName={detail.displayName}
			partition={actionPartition}
		/>

		<div id="historique-wrap">
			<AuditTimeline items={detail.audit} collapsed />
		</div>
	</div>

	<Dialog id="admin-action-dialog" title="Confirmer l’action">
		<Button slot="footer" type="button" variant="secondary" size="sm" id="admin-dialog-cancel">
			Annuler
		</Button>
		<Button slot="footer" type="button" variant="primary" size="sm" id="admin-dialog-confirm">
			Confirmer
		</Button>
	</Dialog>
</AdminLayout>

<script
	is:inline
	id="admin-action-meta"
	type="application/json"
	set:html={JSON.stringify(actionMeta)}
/>
<script>
	import { bindAdminActions } from '../../../components/admin/admin-client';
	import type { AdminActionMetaClient } from '../../../lib/admin/actions';

	const el = document.getElementById('admin-action-meta');
	if (el?.textContent) {
		bindAdminActions(JSON.parse(el.textContent) as AdminActionMetaClient);
	}
</script>
