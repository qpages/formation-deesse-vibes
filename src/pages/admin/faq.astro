---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { requireAdminPage } from '../../lib/admin/auth';

export const prerender = false;

const admin = await requireAdminPage(Astro);
if (admin instanceof Response) return admin;

const sections = [
	{
		id: 'parcours',
		title: 'Parcours client',
		items: [
			{
				q: 'Quel est le parcours d’une inscription ?',
				a: 'Landing → paiement Stripe → signature du NDA (Yousign) → invitation Teachizy. L’accès aux cours n’est jamais ouvert avant paiement + NDA signé.',
			},
			{
				q: 'Inscriptions vs Apprenants ?',
				a: 'Inscriptions = le dossier métier côté portail (paiement, NDA, accès). Apprenants = le miroir Teachizy (comptes côté LMS). Un apprenant sans inscription liée = compte Teachizy hors parcours automatisé.',
			},
		],
	},
	{
		id: 'statuts',
		title: 'Les 3 statuts à ne pas confondre',
		items: [
			{
				q: 'Paiement (chaque échéance) — c’est quoi ?',
				a: 'Chaque ligne Payment = une facture / échéance Stripe. Exemple plan ×4 : 4 lignes, chacune avec son status (`open`, `paid`, `failed`…). Ce n’est pas le résumé global.',
			},
			{
				q: 'Collection — c’est quoi ?',
				a: '`collectionStatus` résume l’ensemble des échéances de l’inscription : `pending` (rien encaissé), `current` (à jour, d’autres à venir), `past_due` (impayé), `paid` (tout soldé), `canceled`, `refunded`.',
			},
			{
				q: 'Accès — c’est quoi ?',
				a: '`accessStatus` répond à « a-t-il accès à Teachizy ? ». Indépendant du détail des factures : il dépend aussi du NDA et des règles d’éligibilité.',
			},
			{
				q: '« Accès en cours » veut dire quoi ?',
				a: '`accessStatus = pending` : paiement OK + NDA signé, et l’invitation Teachizy est en cours de création / envoi. Pas encore `active`.',
			},
		],
	},
	{
		id: 'valeurs',
		title: 'Valeurs utiles',
		items: [
			{
				q: 'Quelles valeurs pour l’accès ?',
				a: '`not_eligible` (conditions pas remplies) → `pending` (invitation en cours) → `active` (ouvert). Puis éventuellement `suspended` (coupé temporairement, souvent impayé) ou `revoked` (retiré pour de bon, ex. remboursement).',
			},
			{
				q: 'Quelles valeurs pour le NDA ?',
				a: '`contractStatus` : `pending` (pas encore envoyé), `sent` (envoyé, à signer), `signed`, puis `expired` / `declined` / `canceled` / `error`. La référence métier est `contractStatus` ; Yousign a ses propres miroirs techniques.',
			},
			{
				q: 'Quand sort-on de « non éligible » ?',
				a: '1er paiement OK + NDA signé + pas d’impayé bloquant + pas annulé/remboursé. Ensuite l’accès passe en `pending` le temps que Teachizy soit provisionné.',
			},
		],
	},
	{
		id: 'cas',
		title: 'Cas fréquents',
		items: [
			{
				q: 'Payé mais pas d’accès ?',
				a: 'Vérifier le NDA : s’il n’est pas `signed`, l’accès reste `not_eligible`. S’il est signé et `accessStatus = pending`, attendre / relancer l’action Teachizy. Si `suspended`, regarder un impayé (`past_due`).',
			},
			{
				q: 'Plan en plusieurs fois : comment lire les statuts ?',
				a: 'Tant que les échéances à venir sont `open` et à jour → `collectionStatus = current` et accès peut rester `active`. Une échéance ratée → `past_due` et souvent `accessStatus = suspended`.',
			},
			{
				q: 'Remboursement ?',
				a: '`collectionStatus` passe à `refunded` et `accessStatus` à `revoked`. L’accès Teachizy ne doit plus être ouvert.',
			},
			{
				q: 'NDA envoyé mais pas signé ?',
				a: '`contractStatus = sent`. Côté détail : e-mail notifié, lien ouvert, expiration du lien (~48h), ou échec de livraison. Actions typiques : renvoyer / copier le lien de signature.',
			},
		],
	},
	{
		id: 'tech',
		title: 'Repères techniques (rapides)',
		items: [
			{
				q: 'Où sont stockés ces champs ?',
				a: 'Table `enrollments` : `collectionStatus`, `contractStatus`, `accessStatus`. Table `payments` : une ligne par échéance avec `status`.',
			},
			{
				q: 'Qu’est-ce qui déclenche l’accès ?',
				a: 'Après signature NDA (webhook Yousign), un job Inngest crée l’invitation Teachizy. Ce n’est jamais déclenché depuis la page « succès » client seule.',
			},
			{
				q: 'Pourquoi la page élève se met à jour toute seule ?',
				a: 'En états transitoires (`collection` pending après checkout, `access` pending…), le front poll jusqu’à stabilisation des webhooks / jobs.',
			},
		],
	},
] as const;
---

<AdminLayout title="FAQ — Admin" email={admin}>
	<div class="mb-8 max-w-3xl">
		<h1 class="font-display text-ink text-4xl">FAQ admin</h1>
		<p class="text-ink-soft mt-2 text-sm">
			Repères métier pour lire une inscription — avec les noms de champs techniques entre
			parenthèses.
		</p>
		<nav
			class="text-ink-soft mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs tracking-[0.12em] uppercase"
			aria-label="Sections FAQ"
		>
			{
				sections.map((section) => (
					<a
						href={`#${section.id}`}
						class="hover:text-ink focus-visible:outline-blush transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
					>
						{section.title}
					</a>
				))
			}
		</nav>
	</div>

	<div class="mx-auto flex max-w-3xl flex-col gap-10">
		{
			sections.map((section) => (
				<section id={section.id} class="scroll-mt-24">
					<h2 class="border-ink/10 font-display text-ink border-b pb-2 text-2xl">
						{section.title}
					</h2>
					<div class="divide-ink/10 border-ink/10 mt-3 divide-y border bg-white/50">
						{section.items.map((item) => (
							<details class="group px-4 py-3 open:bg-white/80">
								<summary class="text-ink cursor-pointer list-none text-sm font-medium marker:content-none [&::-webkit-details-marker]:hidden">
									<span class="flex items-start justify-between gap-3">
										<span>{item.q}</span>
										<span
											class="text-ink/35 mt-0.5 shrink-0 transition-transform group-open:rotate-45"
											aria-hidden="true"
										>
											+
										</span>
									</span>
								</summary>
								<p class="text-ink-soft mt-2 max-w-prose text-sm leading-relaxed">{item.a}</p>
							</details>
						))}
					</div>
				</section>
			))
		}
	</div>
</AdminLayout>
