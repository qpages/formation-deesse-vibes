---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Button from '../../components/ui/Button.astro';
import Dialog from '../../components/ui/Dialog.astro';
import FilterBar from '../../components/admin/FilterBar.astro';
import Pagination from '../../components/admin/Pagination.astro';
import EnrollmentList from '../../components/admin/EnrollmentList.astro';
import { requireAdminPage } from '../../lib/admin/auth';
import { listAdminEnrollments } from '../../lib/admin/enrollments';
import { adminActionMetaForClient } from '../../lib/admin/actions';
import { activeFilterChips } from '../../lib/admin/filter-labels';
import { parseAdminListQuery } from '../../lib/validation';

export const prerender = false;

const admin = await requireAdminPage(Astro);
if (admin instanceof Response) return admin;

const filters = parseAdminListQuery(Astro.url.searchParams);
const list = await listAdminEnrollments(filters);
const actionMeta = adminActionMetaForClient();

const chips = activeFilterChips({
	q: list.q,
	collection: list.collection,
	contract: list.contract,
	access: list.access,
});

const summary =
	list.total === 0
		? list.q || chips.length
			? 'Aucun résultat pour ces critères'
			: 'Aucune inscription'
		: list.q
			? `${list.from}–${list.to} sur ${list.total} pour « ${list.q} »`
			: chips.length
				? `${list.from}–${list.to} sur ${list.total} filtrés`
				: `${list.from}–${list.to} sur ${list.total} clients`;
---

<AdminLayout title="Inscriptions" email={admin}>
	<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
		<div>
			<h1 class="font-display text-4xl text-ink">Inscriptions</h1>
			<p class="mt-2 text-sm text-ink-soft">{summary}</p>
		</div>
		<Button href="/api/admin/export" variant="secondary" size="sm">Export CSV</Button>
	</div>

	<div class="mb-6 border border-ink/10 bg-white/50 p-4">
		<FilterBar
			q={list.q}
			collection={list.collection}
			contract={list.contract}
			access={list.access}
		/>
	</div>

	{
		list.rows.length === 0 ? (
			<p class="border border-dashed border-ink/15 px-4 py-10 text-center text-sm text-ink-soft">
				{list.q || chips.length
					? 'Aucune inscription ne correspond à ces critères.'
					: 'Les inscriptions apparaîtront ici.'}
			</p>
		) : (
			<>
				<EnrollmentList rows={list.rows} />
				<Pagination
					class="mt-6"
					q={list.q}
					page={list.page}
					totalPages={list.totalPages}
					hasPrev={list.hasPrev}
					hasNext={list.hasNext}
					collection={list.collection}
					contract={list.contract}
					access={list.access}
				/>
			</>
		)
	}

	<Dialog id="admin-action-dialog" title="Confirmer l’action">
		<Button slot="footer" type="button" variant="secondary" size="sm" id="admin-dialog-cancel">
			Annuler
		</Button>
		<Button slot="footer" type="button" variant="primary" size="sm" id="admin-dialog-confirm">
			Confirmer
		</Button>
	</Dialog>
</AdminLayout>

<script
	id="admin-action-meta"
	type="application/json"
	set:html={JSON.stringify(actionMeta)}
/>
<script>
	import { bindAdminActions } from '../../components/admin/admin-client';
	import type { AdminActionMetaClient } from '../../lib/admin/actions';

	const el = document.getElementById('admin-action-meta');
	if (el?.textContent) {
		bindAdminActions(JSON.parse(el.textContent) as AdminActionMetaClient);
	}
</script>
