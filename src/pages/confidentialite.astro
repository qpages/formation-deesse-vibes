---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import BackLink from '../components/ui/BackLink.astro';
---

<MarketingLayout title="Confidentialité — Formation Matrice Évolution">
	<div class="h-24 bg-ink"></div>
	<Container class="pt-8 sm:pt-10">
		<BackLink />
	</Container>
	<Section title="Politique de confidentialité" description="Traitement des données pour l’inscription et le suivi.">
		<div class="max-w-2xl space-y-4 text-sm leading-relaxed text-ink-soft">
			<p>
				Nous collectons nom, prénom, e-mail et consentements horodatés pour traiter le
				paiement (Stripe), la signature du NDA (Yousign), l’invitation Teachizy (via Make) et
				le suivi par lien magique (Resend).
			</p>
			<p>
				Les payloads de webhooks sont chiffrés et purgés après 30 jours. Le NDA signé reste
				chez Yousign ; nous conservons uniquement l’identifiant de la demande.
			</p>
			<p class="text-xs text-ink/50">Brouillon — validation juridique et politique de rétention requises.</p>
		</div>
	</Section>
</MarketingLayout>
