---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Section from '../components/ui/Section.astro';
import Hero from '../components/formation/landing/Hero.astro';
import Programme from '../components/formation/landing/Programme.astro';
import AccessPanel from '../components/formation/status/AccessPanel.astro';
import Stepper from '../components/formation/status/Stepper.astro';
import Faq from '../components/formation/landing/Faq.astro';
import { resolveHomeEnrollment } from '../lib/pages/resolve-home-enrollment';

export const prerender = false;

const resolved = await resolveHomeEnrollment({
	cookieHeader: Astro.request.headers.get('cookie'),
	token: Astro.url.searchParams.get('token'),
	sessionId: Astro.url.searchParams.get('session_id'),
	checkout: Astro.url.searchParams.get('checkout'),
	connected: Astro.url.searchParams.get('connected'),
	link: Astro.url.searchParams.get('link'),
});

if (resolved.kind === 'redirect') {
	const response = Astro.redirect(resolved.redirectTo, 303);
	if (resolved.setCookie) {
		response.headers.append('Set-Cookie', resolved.setCookie);
	}
	return response;
}

const view = resolved.view;

if (view.setCookie) {
	Astro.response.headers.append('Set-Cookie', view.setCookie);
}

const {
	enrollment,
	flash,
	checkoutCancel,
	showTracking,
	ndaSignUrl,
	invoiceLinks,
	magicLinkFailed,
} = view;

const accessTitle = showTracking
	? enrollment?.accessStatus === 'active'
		? 'Accès prêt'
		: 'Votre inscription'
	: 'Démarrer ma formation';

const heroCta = showTracking
	? { label: 'Voir mon inscription', href: '#acces', external: false }
	: { label: "M'inscrire à la formation", href: '#acces', external: false };
---

<MarketingLayout>
	<Hero ctaHref={heroCta.href} ctaLabel={heroCta.label} ctaExternal={heroCta.external} />

	<Section
		id="programme"
		eyebrow="Programme"
		title="Ce que vous allez apprendre"
		description="Onze modules pour que vous puissiez apprendre à lire et interpréter la matrice évolution."
		class="border-b border-ink/8 py-8 sm:py-10"
	>
		<Programme />
	</Section>

	<Section
		id="fonctionnement"
		eyebrow="Parcours"
		title="Comment ça fonctionne ?"
		class="border-b border-ink/8"
	>
		<Stepper />
	</Section>

	<Section id="acces" eyebrow="Inscription" title={accessTitle} class="border-b border-ink/8">
		<AccessPanel
			showFunnel={!showTracking}
			enrollment={enrollment}
			ndaSignUrl={ndaSignUrl}
			invoiceLinks={invoiceLinks}
			flash={flash}
			checkoutCancel={checkoutCancel}
			magicLinkFailed={magicLinkFailed}
			defaultTab={magicLinkFailed ? 'retrouver' : 'nouveau'}
		/>
	</Section>

	<Section id="faq" eyebrow="Questions" title="FAQ">
		<Faq />
	</Section>
</MarketingLayout>
