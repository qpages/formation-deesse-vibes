---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Section from '../components/ui/Section.astro';
---

<MarketingLayout title="CGV — Formation Matrice Évolution">
	<div class="h-24 bg-ink"></div>
	<Section title="Conditions générales de vente" description="Document à finaliser avant la mise en production.">
		<div class="prose-legal max-w-2xl space-y-4 text-sm leading-relaxed text-ink-soft">
			<p>
				Les présentes conditions régissent l’achat de la Formation Matrice Évolution au tarif
				de 1 849 € TTC en paiement unique (majoré en cas de paiement fractionné), dispensée
				en ligne via Teachizy.
			</p>
			<p>
				L’accès à la formation est conditionné au paiement confirmé et à la signature de
				l’accord de confidentialité. Les remboursements après ouverture des accès sont traités
				manuellement.
			</p>
			<p class="text-xs text-ink/50">Brouillon — validation juridique requise.</p>
		</div>
	</Section>
</MarketingLayout>
