---
import { cn } from '../../lib/cn';

interface Props {
	label: string;
	name: string;
	hint?: string;
	class?: string;
}

const { label, name, hint, class: className } = Astro.props;
---

<label class={cn('block space-y-2', className)} for={name}>
	<span class="text-ink text-sm font-medium">{label}</span>
	<slot />
	{hint && <span class="text-ink-soft/80 block text-xs">{hint}</span>}
</label>
