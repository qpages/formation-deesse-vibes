---
import { cn } from '../../lib/cn';

interface Props {
	id: string;
	title?: string;
	size?: 'sm' | 'lg';
	class?: string;
}

const { id, title = '', size = 'sm', class: className } = Astro.props;
---

<dialog
	id={id}
	class={cn('admin-dialog', size === 'lg' && 'admin-dialog--lg', className)}
	aria-labelledby={`${id}-title`}
	aria-describedby={`${id}-desc`}
>
	<div class="admin-dialog__panel grain relative overflow-hidden">
		<div
			class="via-gold/50 pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent to-transparent"
			aria-hidden="true"
		>
		</div>

		<header class="pr-8">
			<p data-dialog-eyebrow class="text-gold text-[10px] font-medium tracking-[0.22em] uppercase">
			</p>
			<h2
				id={`${id}-title`}
				data-dialog-title
				class="font-display text-ink mt-2 text-[1.85rem] leading-tight"
			>
				{title}
			</h2>
		</header>

		<button
			type="button"
			data-dialog-close
			class="text-ink/40 hover:text-ink absolute top-4 right-4 flex size-8 items-center justify-center transition-colors"
			aria-label="Fermer"
		>
			<svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.25"></path>
			</svg>
		</button>

		<p
			id={`${id}-desc`}
			data-dialog-description
			class="text-ink-soft mt-3 text-sm leading-relaxed empty:hidden"
		>
		</p>

		<div data-dialog-body class="mt-4 empty:mt-0 empty:hidden">
			<slot />
		</div>

		<footer class="mt-8 flex flex-wrap items-center justify-end gap-2.5 empty:hidden">
			<slot name="footer" />
		</footer>
	</div>
</dialog>

<style>
	.admin-dialog {
		margin: auto;
		max-width: calc(100% - 1.5rem);
		width: min(100%, 26.5rem);
		border: 0;
		background: transparent;
		padding: 0;
		color: var(--color-ink);
	}

	.admin-dialog--lg {
		width: min(100%, 36rem);
	}

	.admin-dialog::backdrop {
		background: radial-gradient(
			ellipse 70% 50% at 50% 40%,
			rgb(26 20 16 / 0.35),
			rgb(26 20 16 / 0.55)
		);
		backdrop-filter: blur(4px);
	}

	.admin-dialog__panel {
		border: 1px solid rgb(26 20 16 / 0.1);
		background: var(--color-surface);
		padding: 1.5rem 1.25rem 1.25rem;
		box-shadow:
			0 1px 0 rgb(255 255 255 / 0.65) inset,
			var(--shadow-soft),
			0 40px 80px rgb(26 20 16 / 0.14);
		max-height: min(90dvh, 52rem);
		overflow-y: auto;
	}

	@media (min-width: 640px) {
		.admin-dialog__panel {
			padding: 1.75rem 1.75rem 1.5rem;
		}
	}

	.admin-dialog[open] {
		animation: dialog-rise 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.admin-dialog[open]::backdrop {
		animation: dialog-backdrop 0.32s ease both;
	}

	@keyframes dialog-rise {
		from {
			opacity: 0;
			transform: translateY(14px) scale(0.985);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes dialog-backdrop {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.admin-dialog[open],
		.admin-dialog[open]::backdrop {
			animation: none !important;
		}
	}
</style>
