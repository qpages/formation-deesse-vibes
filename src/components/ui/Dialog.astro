---
import { cn } from '../../lib/cn';

interface Props {
	id: string;
	title: string;
	class?: string;
}

const { id, title, class: className } = Astro.props;
---

<dialog
	id={id}
	class={cn(
		'w-[min(100%,28rem)] rounded-sm border border-ink/10 bg-surface p-6 text-ink shadow-[var(--shadow-soft)] backdrop:bg-ink/40',
		className,
	)}
>
	<form method="dialog" class="space-y-4">
		<header class="flex items-start justify-between gap-4">
			<h2 class="font-display text-2xl">{title}</h2>
			<button type="submit" class="text-ink-soft hover:text-ink" aria-label="Fermer">
				×
			</button>
		</header>
		<div>
			<slot />
		</div>
	</form>
</dialog>
