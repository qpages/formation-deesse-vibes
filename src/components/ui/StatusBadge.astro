---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';

const badge = cva(
	'inline-flex w-fit shrink-0 items-center justify-center rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap',
	{
		variants: {
			tone: {
				neutral: 'border-ink/20 bg-transparent text-ink',
				progress: 'border-transparent bg-ink/10 text-ink',
				success: 'border-transparent bg-ink text-mist',
				action: 'border-transparent bg-blush/15 text-blush-deep',
			},
		},
		defaultVariants: { tone: 'neutral' },
	},
);

type Props = VariantProps<typeof badge> & { class?: string };

const { tone, class: className } = Astro.props;
---

<span class={cn(badge({ tone }), className)}>
	<slot />
</span>
