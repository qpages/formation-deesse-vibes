---
/**
 * Fixed toast host. Call window.toast(message, variant?) from client scripts.
 */
---

<div
	id="toast-host"
	class="pointer-events-none fixed inset-x-0 bottom-0 z-60 flex flex-col items-end gap-2 p-4 sm:p-6"
	aria-live="polite"
	aria-relevant="additions"
>
</div>

<style>
	@keyframes toast-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes toast-out {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	:global(.toast-item) {
		animation: toast-in 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	:global(.toast-item.is-leaving) {
		animation: toast-out 0.28s ease forwards;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.toast-item),
		:global(.toast-item.is-leaving) {
			animation: none !important;
		}
	}
</style>

<script>
	const variantClass: Record<ToastVariant, string> = {
		success: 'border-sage/55 bg-surface text-ink shadow-soft',
		error: 'border-blush-deep/50 bg-surface text-ink shadow-soft',
		info: 'border-gold/60 bg-surface text-ink shadow-soft',
	};

	const accentClass: Record<ToastVariant, string> = {
		success: 'bg-sage',
		error: 'bg-blush-deep',
		info: 'bg-gold',
	};

	window.toast = (message, variant = 'info') => {
		const host = document.getElementById('toast-host');
		if (!host) return;
		const kind: ToastVariant = variant ?? 'info';

		const el = document.createElement('div');
		el.role = 'status';
		el.className = [
			'toast-item pointer-events-auto flex w-[min(100%,22rem)] items-start gap-3',
			'rounded-sm border px-4 py-3.5 text-sm leading-snug',
			variantClass[kind],
		].join(' ');

		const accent = document.createElement('span');
		accent.className = `mt-1.5 size-1.5 shrink-0 rounded-full ${accentClass[kind]}`;
		accent.setAttribute('aria-hidden', 'true');

		const text = document.createElement('p');
		text.className = 'min-w-0 flex-1';
		text.textContent = message;

		el.append(accent, text);
		host.appendChild(el);

		window.setTimeout(() => {
			el.classList.add('is-leaving');
			const remove = () => el.remove();
			el.addEventListener('animationend', remove, { once: true });
			window.setTimeout(remove, 400);
		}, 4000);
	};
</script>
