---
import { cn } from '../../lib/cn';
import Container from './Container.astro';

interface Props {
	class?: string;
	id?: string;
	eyebrow?: string;
	title?: string;
	description?: string;
}

const { class: className, id, eyebrow, title, description } = Astro.props;
---

<section id={id} class={cn('py-10 sm:py-14', className)}>
	<Container>
		{(eyebrow || title || description) && (
			<header class="mb-7 max-w-2xl sm:mb-8">
				{eyebrow && (
					<p class="mb-3 text-xs font-medium uppercase tracking-[0.22em] text-blush-deep">
						{eyebrow}
					</p>
				)}
				{(title || description) && (
					<div class="space-y-2">
						{title && <h2 class="font-display text-3xl text-ink">{title}</h2>}
						{description && <p class="text-ink-soft">{description}</p>}
					</div>
				)}
			</header>
		)}
		<slot />
	</Container>
</section>
