---
import { cn } from '../../lib/cn';
import Container from './Container.astro';

interface Props {
	class?: string;
	id?: string;
	eyebrow?: string;
	title?: string;
	description?: string;
}

const { class: className, id, eyebrow, title, description } = Astro.props;
---

<section id={id} class={cn('py-10 sm:py-14', className)}>
	<Container>
		{(eyebrow || title || description) && (
			<header class="mb-7 max-w-2xl sm:mb-8">
				{eyebrow && (
					<p class="mb-3 text-xs font-medium uppercase tracking-[0.22em] text-blush-deep">
						{eyebrow}
					</p>
				)}
				{title && (
					<h2 class="font-display text-4xl leading-tight text-ink sm:text-[2.75rem] text-balance">
						{title}
					</h2>
				)}
				{description && (
					<p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">
						{description}
					</p>
				)}
			</header>
		)}
		<slot />
	</Container>
</section>
