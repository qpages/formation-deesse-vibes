---
import StatusBadge from '../../ui/StatusBadge.astro';
import { expandAdminInstallments, type AdminPaymentSummary } from '../../../lib/admin/payments';

interface Props {
	summary: AdminPaymentSummary;
	heading?: string;
}

const { summary, heading } = Astro.props;

const installments = expandAdminInstallments(summary);
const total = summary.installmentsTotal ?? 1;
const collected = new Intl.NumberFormat('fr-FR', {
	style: 'currency',
	currency: 'EUR',
}).format(summary.collectedAmountCents / 100);
const totalLabel =
	summary.totalAmountCents != null
		? new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(
				summary.totalAmountCents / 100,
			)
		: null;
const nextDue = summary.nextInstallmentDueAt
	? new Date(summary.nextInstallmentDueAt).toLocaleDateString('fr-FR')
	: null;
const showNextDue =
	Boolean(nextDue) && summary.trackingState !== 'termine' && summary.trackingState !== 'rembourse';
const subscriptionEnd = summary.subscriptionEndsAt
	? new Date(summary.subscriptionEndsAt).toLocaleDateString('fr-FR')
	: null;
const showSubscriptionEnd =
	Boolean(subscriptionEnd) &&
	summary.trackingState !== 'termine' &&
	summary.trackingState !== 'rembourse' &&
	summary.installmentsTotal != null &&
	summary.installmentsTotal > 1;

const statusTone = {
	paid: 'success',
	open: 'progress',
	failed: 'action',
	uncollectible: 'action',
	void: 'neutral',
	draft: 'neutral',
} as const;

function formatDate(iso: string | null, withTime = false) {
	if (!iso) return null;
	return new Date(iso).toLocaleString('fr-FR', {
		dateStyle: 'short',
		...(withTime ? { timeStyle: 'short' } : {}),
	});
}

const installmentSummary = `${summary.installmentsPaid}/${total}`;
const openInstallments =
	summary.trackingState === 'impaye' ||
	installments.some((p) => p.status === 'failed' || p.status === 'uncollectible');

const realPayments = summary.payments.filter((p) => !p.id.startsWith('estimated-'));
const techRows: Array<{ label: string; value: string; href?: string | null }> = [];
if (summary.stripeCheckoutSessionId) {
	techRows.push({
		label: 'Checkout',
		value: summary.stripeCheckoutSessionId,
		href: summary.stripeCheckoutUrl,
	});
}
for (const p of realPayments) {
	const prefix = realPayments.length > 1 ? `Échéance ${p.installmentNumber} · ` : '';
	techRows.push({
		label: `${prefix}Invoice ID`,
		value: p.stripeInvoiceId ?? '—',
	});
	techRows.push({
		label: `${prefix}PaymentIntent`,
		value: p.stripePaymentIntentId ?? '—',
		href: p.stripePaymentIntentId ? p.stripeUrl : null,
	});
	techRows.push({
		label: `${prefix}Facture PDF`,
		value: p.invoicePdfUrl ? 'Ouvrir' : '—',
		href: p.invoicePdfUrl,
	});
	techRows.push({
		label: `${prefix}Page facture`,
		value: p.hostedInvoiceUrl ? 'Ouvrir' : '—',
		href: p.hostedInvoiceUrl,
	});
}

const linkClass =
	'text-sm text-ink-soft underline underline-offset-2 hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';
const summaryClass = [
	'cursor-pointer list-none py-1',
	linkClass,
	'[&::-webkit-details-marker]:hidden',
];
---

<section class="mb-8 scroll-mt-20" id="paiements" aria-labelledby="paiements-heading">
	<div class="mb-3 flex flex-wrap items-center gap-2">
		{
			heading ? (
				<h2 id="paiements-heading" class="text-ink text-lg font-medium">
					{heading}
				</h2>
			) : (
				<h2 id="paiements-heading" class="sr-only">
					Paiements
				</h2>
			)
		}
		<StatusBadge tone={summary.trackingTone}>{summary.trackingLabel}</StatusBadge>
	</div>

	<p class="text-ink text-sm tabular-nums">
		<span class="text-ink/45">{summary.planLabel}</span>
		<span class="text-ink/25 mx-1.5">·</span>
		<span class="font-medium">{collected}</span>
		{totalLabel ? <span class="text-ink/35"> / {totalLabel}</span> : null}
		<span class="text-ink/25 mx-1.5">·</span>
		<span class="text-ink-soft">{installmentSummary}</span>
		{showNextDue ? <span class="text-ink-soft"> · prochain {nextDue}</span> : null}
		{showSubscriptionEnd ? <span class="text-ink-soft"> · fin abo {subscriptionEnd}</span> : null}
	</p>

	{
		installments.length === 0 ? (
			<div class="mt-3 flex flex-wrap items-center gap-x-4">
				<p class="text-ink-soft text-sm">
					Aucune échéance. Sync Stripe pour charger le calendrier.
				</p>
				{summary.stripeSubscriptionUrl ? (
					<a
						href={summary.stripeSubscriptionUrl}
						target="_blank"
						rel="noopener noreferrer"
						class={linkClass}
					>
						Abonnement Stripe ↗
					</a>
				) : null}
				{summary.stripeScheduleUrl ? (
					<a
						href={summary.stripeScheduleUrl}
						target="_blank"
						rel="noopener noreferrer"
						class={linkClass}
					>
						Schedule Stripe ↗
					</a>
				) : null}
			</div>
		) : (
			<div class="mt-3 flex flex-wrap items-center gap-x-4">
				<details class="peer/echeances group/echeances" open={openInstallments || undefined}>
					<summary class:list={summaryClass}>
						<span class="group-open/echeances:hidden">Voir les échéances</span>
						<span class="hidden group-open/echeances:inline">Masquer les échéances</span>
					</summary>
				</details>
				<details class="peer/detail group/detail">
					<summary class:list={summaryClass}>
						<span class="group-open/detail:hidden">Voir le détail</span>
						<span class="hidden group-open/detail:inline">Masquer le détail</span>
					</summary>
				</details>
				{summary.stripeCheckoutUrl ? (
					<a
						href={summary.stripeCheckoutUrl}
						target="_blank"
						rel="noopener noreferrer"
						class={linkClass}
					>
						Checkout Stripe ↗
					</a>
				) : null}
				{summary.stripeSubscriptionUrl ? (
					<a
						href={summary.stripeSubscriptionUrl}
						target="_blank"
						rel="noopener noreferrer"
						class={linkClass}
					>
						Abonnement Stripe ↗
					</a>
				) : null}
				{summary.stripeScheduleUrl ? (
					<a
						href={summary.stripeScheduleUrl}
						target="_blank"
						rel="noopener noreferrer"
						class={linkClass}
					>
						Schedule Stripe ↗
					</a>
				) : null}
				<ul class="divide-ink/10 border-ink/10 mt-2 hidden w-full basis-full divide-y border-t peer-open/echeances:block">
					{installments.map((p) => {
						const paid = formatDate(p.paidAt, true);
						const due = formatDate(p.dueAt);
						const meta = paid ? `Payé le ${paid}` : due ? `Échéance ${due}` : 'Date à venir';
						const tone = statusTone[p.status] ?? 'neutral';
						const invoiceHref = p.invoicePdfUrl ?? p.hostedInvoiceUrl;
						const isEstimated = p.id.startsWith('estimated-');
						const missingInvoice = !isEstimated && p.status === 'paid' && !p.stripeInvoiceId;
						return (
							<li class="flex items-start gap-3 py-3">
								<span class="text-ink/45 mt-0.5 w-5 shrink-0 text-xs font-medium tabular-nums">
									{p.installmentNumber}
								</span>
								<div class="min-w-0 flex-1">
									<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
										<span class="text-ink font-medium tabular-nums">{p.amountLabel}</span>
										<StatusBadge tone={tone}>{p.statusLabel}</StatusBadge>
										{isEstimated ? <span class="text-ink/40 text-xs">estimée</span> : null}
									</div>
									<p class="text-ink-soft mt-1 text-sm">{meta}</p>
									{p.failureReason ? (
										<p class="text-blush-deep mt-1 text-sm">{p.failureReason}</p>
									) : null}
									{invoiceHref ? (
										<p class="mt-1">
											<a
												href={invoiceHref}
												target="_blank"
												rel="noopener noreferrer"
												class={linkClass}
											>
												{p.invoicePdfUrl ? 'Facture PDF' : 'Facture'}
											</a>
										</p>
									) : missingInvoice ? (
										<p class="text-ink/40 mt-1 text-sm">Facture Stripe non liée</p>
									) : null}
								</div>
								{p.stripeUrl ? (
									<a
										href={p.stripeUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="text-ink/45 hover:text-ink focus-visible:outline-blush mt-0.5 inline-flex min-h-9 shrink-0 items-center text-xs underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
										aria-label={`Ouvrir l’échéance ${p.installmentNumber} dans Stripe`}
									>
										Stripe
									</a>
								) : null}
							</li>
						);
					})}
				</ul>
				<dl class="mt-3 hidden w-full basis-full gap-x-6 gap-y-2 peer-open/detail:grid sm:grid-cols-2">
					{techRows.map((row) => (
						<div class="flex min-w-0 gap-2 text-sm">
							<dt class="text-ink/45 shrink-0">{row.label}</dt>
							<dd class="text-ink min-w-0 break-all">
								{row.href ? (
									<a href={row.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
										{row.value}
									</a>
								) : (
									row.value
								)}
							</dd>
						</div>
					))}
				</dl>
			</div>
		)
	}
</section>
