---
import type { PipelineStageCard } from '../../../lib/admin/pipeline-detail';

interface Props {
	stages: PipelineStageCard[];
}

const { stages } = Astro.props;

const toneDot: Record<PipelineStageCard['tone'], string> = {
	neutral: 'bg-ink/25',
	progress: 'bg-gold',
	success: 'bg-sage',
	action: 'bg-blush-deep',
};
---

<nav class="my-2 mb-10 scroll-mt-20 py-5" id="pipeline" aria-label="Pipeline inscription">
	<ol class="grid gap-5 sm:grid-cols-3 sm:gap-8">
		{
			stages.map((stage) => (
				<li class="min-w-0">
					<a
						href={stage.href}
						class:list={[
							'group focus-visible:outline-blush flex min-h-10 items-baseline gap-2.5 rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2',
							stage.blocking ? 'text-ink' : 'text-ink-soft hover:text-ink',
						]}
					>
						<span
							class:list={['mt-1.5 size-2 shrink-0 rounded-full', toneDot[stage.tone]]}
							aria-hidden="true"
						/>
						<span class="min-w-0">
							<span class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
								<span class="text-ink text-sm font-medium">{stage.title}</span>
								<span class="text-sm">{stage.label}</span>
							</span>
							<span class="text-ink/45 group-hover:text-ink/60 mt-1 block truncate text-xs">
								{stage.hint}
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ol>
</nav>
