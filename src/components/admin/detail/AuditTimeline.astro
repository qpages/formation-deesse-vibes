---
interface Props {
	items: Array<{
		id: string;
		actionLabel: string;
		adminEmail: string;
		createdAt: Date;
	}>;
	/** When true, section starts collapsed (detail dump). */
	collapsed?: boolean;
}

const { items, collapsed = false } = Astro.props;
const countLabel = items.length === 0 ? 'vide' : `${items.length}`;
---

<section class="scroll-mt-20" id="historique" aria-labelledby="historique-heading">
	{
		collapsed ? (
			<details class="group border border-ink/10 bg-white/60 open:bg-white/70">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blush [&::-webkit-details-marker]:hidden">
					<h2 id="historique-heading" class="font-display text-2xl text-ink">
						Historique
					</h2>
					<span class="text-sm text-ink/45">
						{countLabel}
						<span class="ml-2 text-ink/35 group-open:hidden">· afficher</span>
						<span class="ml-2 hidden text-ink/35 group-open:inline">· masquer</span>
					</span>
				</summary>
				<div class="border-t border-ink/10 px-4 pb-4 pt-3">
					{items.length === 0 ? (
						<p class="border border-dashed border-ink/15 px-4 py-6 text-sm text-ink-soft">
							Aucune action admin pour le moment. Les syncs et actions métier apparaîtront ici.
						</p>
					) : (
						<ol class="divide-y divide-ink/10 border border-ink/10">
							{items.map((item) => (
								<li class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
									<div class="min-w-0">
										<p class="font-medium text-ink">{item.actionLabel}</p>
										<p class="text-sm text-ink-soft">{item.adminEmail}</p>
									</div>
									<time
										class="shrink-0 text-xs text-ink/50"
										datetime={item.createdAt.toISOString()}
									>
										{item.createdAt.toLocaleString('fr-FR', {
											dateStyle: 'short',
											timeStyle: 'short',
										})}
									</time>
								</li>
							))}
						</ol>
					)}
				</div>
			</details>
		) : (
			<>
				<h2 id="historique-heading" class="font-display text-2xl text-ink">
					Historique
				</h2>
				{items.length === 0 ? (
					<p class="mt-3 border border-dashed border-ink/15 px-4 py-6 text-sm text-ink-soft">
						Aucune action admin pour le moment.
					</p>
				) : (
					<ol class="mt-3 divide-y divide-ink/10 border border-ink/10">
						{items.map((item) => (
							<li class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
								<div class="min-w-0">
									<p class="font-medium text-ink">{item.actionLabel}</p>
									<p class="text-sm text-ink-soft">{item.adminEmail}</p>
								</div>
								<time
									class="shrink-0 text-xs text-ink/50"
									datetime={item.createdAt.toISOString()}
								>
									{item.createdAt.toLocaleString('fr-FR', {
										dateStyle: 'short',
										timeStyle: 'short',
									})}
								</time>
							</li>
						))}
					</ol>
				)}
			</>
		)
	}
</section>
