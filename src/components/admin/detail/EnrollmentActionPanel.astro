---
import type { PartitionedAdminActions } from '../../../lib/admin/actions';

interface Props {
	enrollmentId: string;
	displayName: string;
	partition: PartitionedAdminActions;
}

const { enrollmentId, displayName, partition } = Astro.props;
/** Recommended CTA lives in EnrollmentNextAction — panel is the dump. */
const { secondary, danger } = partition;

const btnBase =
	'inline-flex min-h-11 items-center justify-center rounded-sm px-4 text-sm font-medium transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';
const btnSecondary = `${btnBase} border border-ink/20 bg-transparent text-ink hover:border-ink/40 hover:bg-surface/60`;
const btnGhost = `${btnBase} text-ink-soft underline-offset-4 hover:text-ink hover:underline`;
const btnDanger = `${btnBase} text-blush-deep underline-offset-4 hover:text-blush hover:underline`;

const hasSecondary = secondary.length > 0;
const hasDanger = danger.length > 0;
const hasAnything = hasSecondary || hasDanger;
---

<section
	id="actions"
	class="mb-8 scroll-mt-20 border border-ink/10 bg-white/60 p-4 sm:p-5"
	aria-labelledby="actions-heading"
	data-action-zone
	data-enrollment={enrollmentId}
	data-name={displayName}
>
	<h2 id="actions-heading" class="font-display text-2xl text-ink">Actions</h2>
	<p class="mt-1 text-sm text-ink-soft">
		Autres actions et opérations sensibles. La recommandation principale est en haut de page.
	</p>

	{
		!hasAnything ? (
			<p class="mt-4 text-sm text-ink-soft">Aucune autre action pour ce dossier.</p>
		) : (
			<div class="mt-4 space-y-5">
				{hasSecondary ? (
					<div>
						<p class="mb-2 text-xs font-medium uppercase tracking-[0.12em] text-ink/55">
							Autres
						</p>
						<div class="flex flex-wrap gap-2">
							{secondary.map((action) => (
								<button
									type="button"
									data-action={action.action}
									class={action.zone === 'recovery' ? btnGhost : btnSecondary}
								>
									{action.label}
								</button>
							))}
						</div>
					</div>
				) : null}

				{hasDanger ? (
					<details class="group border-t border-ink/10 pt-4">
						<summary class="cursor-pointer text-sm font-medium text-ink-soft transition-colors hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush">
							Actions sensibles
							<span class="ml-1 text-ink/40 group-open:hidden">(masquées)</span>
						</summary>
						<p class="mt-2 text-sm text-ink/55">
							Irréversibles ou destructives — confirmez avant d’exécuter.
						</p>
						<div class="mt-3 flex flex-wrap gap-2">
							{danger.map((action) => (
								<button type="button" data-action={action.action} class={btnDanger}>
									{action.label}
								</button>
							))}
						</div>
					</details>
				) : null}
			</div>
		)
	}
</section>
