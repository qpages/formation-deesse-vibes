---
import type {
	AdminActionExecution,
	PartitionedAdminActions,
} from '../../../lib/admin/actions';

interface Props {
	enrollmentId: string;
	displayName: string;
	partition: PartitionedAdminActions;
}

const { enrollmentId, displayName, partition } = Astro.props;
const { actions } = partition;

const btnGhost =
	'inline-flex min-h-9 items-center justify-center gap-1.5 px-2 text-sm text-ink-soft underline-offset-4 transition-colors hover:text-ink hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';

// Marqueur discret : sépare la lecture (safe, idempotent) de l'envoi (job → e-mail).
const kindMeta: Record<AdminActionExecution, { tag: string; hint: string; cls: string }> = {
	sync: {
		tag: 'sync',
		hint: 'Lecture provider + alignement DB. Aucun e-mail envoyé.',
		cls: 'text-ink/35',
	},
	flow: {
		tag: 'envoi',
		hint: 'Déclenche un job Inngest (e-mail / invitation à l’apprenante).',
		cls: 'text-gold',
	},
	read: { tag: 'lecture', hint: 'Lecture seule.', cls: 'text-ink/35' },
};
---

{
	actions.length > 0 ? (
		<section
			id="actions"
			class="mb-8 scroll-mt-20"
			aria-labelledby="actions-heading"
			data-action-zone
			data-enrollment={enrollmentId}
			data-name={displayName}
		>
			<details class="group">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush [&::-webkit-details-marker]:hidden">
					<h2 id="actions-heading" class="text-lg font-medium text-ink">
						Actions
						<span class="ml-1.5 text-sm font-normal text-ink/40">{actions.length}</span>
					</h2>
					<span class="text-sm text-ink/40 group-open:hidden">afficher</span>
					<span class="hidden text-sm text-ink/40 group-open:inline">masquer</span>
				</summary>
				<div class="mt-3 flex flex-wrap gap-1">
					{actions.map((action) => (
						<button type="button" data-action={action.action} class={btnGhost}>
							{action.label}
							<span
								class:list={[
									'text-[10px] font-medium uppercase tracking-wider',
									kindMeta[action.execution].cls,
								]}
								title={kindMeta[action.execution].hint}
							>
								{kindMeta[action.execution].tag}
							</span>
						</button>
					))}
				</div>
			</details>
		</section>
	) : null
}
