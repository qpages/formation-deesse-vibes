---
import type { PartitionedAdminActions } from '../../../lib/admin/actions';

interface Props {
	enrollmentId: string;
	displayName: string;
	partition: PartitionedAdminActions;
}

const { enrollmentId, displayName, partition } = Astro.props;
const { recommended, reason } = partition;
---

{
	recommended ? (
		<section
			id="next-action"
			class="mb-6 scroll-mt-20 border border-ink/15 bg-white/70 px-4 py-4 sm:px-5"
			aria-labelledby="next-action-title"
			data-action-zone
			data-enrollment={enrollmentId}
			data-name={displayName}
		>
			<div class="flex flex-wrap items-start justify-between gap-4">
				<div class="min-w-0 max-w-xl">
					<h2 id="next-action-title" class="font-display text-xl text-ink">
						À faire maintenant
					</h2>
					{reason ? <p class="mt-1.5 text-sm text-ink-soft">{reason}</p> : null}
				</div>
				<button
					type="button"
					data-action={recommended.action}
					class="inline-flex min-h-11 items-center justify-center rounded-sm bg-ink px-5 text-sm font-medium text-mist shadow-[0_12px_30px_rgb(26_20_16/0.18)] transition-colors hover:bg-ink-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush"
				>
					{recommended.label}
				</button>
			</div>
		</section>
	) : (
		<section
			id="next-action"
			class="mb-6 scroll-mt-20 border border-dashed border-ink/15 bg-white/40 px-4 py-4 sm:px-5"
			aria-labelledby="next-action-title"
		>
			<h2 id="next-action-title" class="font-display text-xl text-ink">
				Rien à débloquer
			</h2>
			<p class="mt-1.5 text-sm text-ink-soft">
				Aucune action productive recommandée. Consultez le détail ci-dessous ou les actions
				sensibles si besoin.
			</p>
		</section>
	)
}
