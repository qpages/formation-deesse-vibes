---
interface Props {
	stripeUrl: string | null;
	yousignUrl: string | null;
}

const { stripeUrl, yousignUrl } = Astro.props;

const iconClass =
	'inline-flex size-10 items-center justify-center rounded-sm text-ink/55 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';
const activeClass = `${iconClass} hover:bg-ink/5 hover:text-ink`;
const disabledClass = `${iconClass} cursor-not-allowed opacity-30`;
---

<div class="flex items-center gap-0.5">
	{
		stripeUrl ? (
			<a
				href={stripeUrl}
				target="_blank"
				rel="noopener noreferrer"
				class={activeClass}
				aria-label="Voir sur Stripe"
				title="Stripe"
			>
				<svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.591-7.305z"
					/>
				</svg>
			</a>
		) : (
			<span class={disabledClass} aria-label="Pas de lien Stripe" title="Pas de Stripe">
				<svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.591-7.305z"
					/>
				</svg>
			</span>
		)
	}
	{
		yousignUrl ? (
			<a
				href={yousignUrl}
				target="_blank"
				rel="noopener noreferrer"
				class={activeClass}
				aria-label="Lien de signature"
				title="Lien de signature"
			>
				<svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M3.9 12a5 5 0 0 1 5-5h4v2h-4a3 3 0 1 0 0 6h4v2h-4a5 5 0 0 1 5-5zm5.1 1h6v-2h-6v2zm6-6h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 1 0 0-6h-4V7z"
					/>
				</svg>
			</a>
		) : (
			<span
				class={disabledClass}
				aria-label="Pas de lien de signature — disponible après confirmation du paiement"
				title="Pas de lien de signature"
			>
				<svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
					<path
						fill="currentColor"
						d="M3.9 12a5 5 0 0 1 5-5h4v2h-4a3 3 0 1 0 0 6h4v2h-4a5 5 0 0 1 5-5zm5.1 1h6v-2h-6v2zm6-6h4a5 5 0 0 1 0 10h-4v-2h4a3 3 0 1 0 0-6h-4V7z"
					/>
				</svg>
			</span>
		)
	}
</div>
