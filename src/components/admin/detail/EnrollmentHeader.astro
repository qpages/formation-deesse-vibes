---
import StatusBadge from '../../ui/StatusBadge.astro';
import type { EnrollmentHeadline } from '../../../lib/admin/pipeline-detail';

interface Props {
	displayName: string;
	email: string;
	enrollmentId: string;
	createdAt: Date;
	headline: EnrollmentHeadline;
}

const { displayName, email, enrollmentId, createdAt, headline } = Astro.props;

const shortId = enrollmentId.slice(0, 8);
const createdLabel = createdAt.toLocaleString('fr-FR', {
	dateStyle: 'short',
	timeStyle: 'short',
});
---

<header id="enrollment-header" class="mb-5">
	<a
		href="/admin/inscriptions"
		class="inline-flex min-h-9 items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush"
	>
		<svg class="size-3.5 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
			<path
				d="M10 3.5 5.5 8 10 12.5"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
		Retour
	</a>

	<div class="mt-3">
		<div class="flex min-w-0 flex-wrap items-center gap-2">
			<h1 class="font-display text-3xl leading-none text-ink sm:text-4xl">
				{displayName}
			</h1>
			<StatusBadge tone={headline.tone}>{headline.label}</StatusBadge>
		</div>
		<div class="mt-2.5 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-soft">
			<a
				href={`mailto:${email}`}
				class="min-w-0 break-all underline-offset-2 hover:text-ink hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush"
			>
				{email}
			</a>
			<span class="text-ink/25" aria-hidden="true">·</span>
			<span class="tabular-nums text-ink/45">Créé {createdLabel}</span>
			<span class="text-ink/25" aria-hidden="true">·</span>
			<button
				type="button"
				data-copy-text={enrollmentId}
				data-copy-success="ID copié."
				class="font-mono text-xs tracking-wide text-ink/45 underline-offset-2 hover:text-ink hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush"
				title={enrollmentId}
			>
				{shortId}
			</button>
		</div>
	</div>
</header>
