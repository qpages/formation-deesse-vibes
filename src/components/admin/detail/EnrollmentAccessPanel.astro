---
import StatusBadge from '../../ui/StatusBadge.astro';
import type { AdminActionDef } from '../../../lib/admin/actions';
import type { AdminEnrollmentDetail } from '../../../lib/admin/enrollments';
import { ACCESS_STATUS_LABELS, TEACHIZY_ACADEMY_URL } from '../../../lib/status';
import {
	formatLearnerDate,
	formatLearnerDuration,
	learnerStatusLabel,
	type AdminTeachizyLearnerResult,
} from '../../../lib/admin/teachizy-learners';

interface Props {
	detail: AdminEnrollmentDetail;
	enrollmentId: string;
	displayName: string;
	teachizy: AdminTeachizyLearnerResult;
	actions?: AdminActionDef[];
}

const { detail, enrollmentId, displayName, teachizy, actions = [] } = Astro.props;
const learner = teachizy.learner;

const btnBase =
	'inline-flex min-h-9 items-center justify-center border border-ink/20 bg-transparent px-3 text-sm font-medium text-ink transition-colors hover:border-ink/40 hover:bg-surface/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';

const linkClass =
	'text-sm text-ink-soft underline underline-offset-2 hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';

let hint: string | null = null;
if (detail.contractStatus !== 'signed') {
	hint = 'Après signature du NDA';
} else if (detail.accessStatus === 'suspended') {
	hint = 'Coupé — réinvitez si paiement OK';
}

const rows = learner
	? [
			{ label: 'Statut formation', value: learnerStatusLabel(learner.trainingStatus) },
			{
				label: 'Compte',
				value:
					learner.accountStatus === 'DISABLED'
						? 'Désactivé'
						: learner.accountStatus === 'ACTIVE'
							? 'Actif'
							: '—',
			},
			{ label: 'Formation', value: learner.trainingName ?? '—' },
			{
				label: 'Progression',
				value: `${learner.progressionPercent} % · ${learner.itemsCompleted}/${learner.itemsTotal} leçons`,
			},
			{ label: 'Temps passé', value: formatLearnerDuration(learner.durationSeconds) },
			{
				label: 'Quiz',
				value: learner.quizPercent == null ? '—' : `${Math.round(learner.quizPercent)} %`,
			},
			{ label: 'Inscrit le', value: formatLearnerDate(learner.enrolledAt) },
			{ label: 'Commencé le', value: formatLearnerDate(learner.startedAt) },
			{ label: 'Terminé le', value: formatLearnerDate(learner.completedAt) },
			{ label: 'Dernière activité', value: formatLearnerDate(learner.lastActivityAt) },
			{ label: 'Dernière connexion', value: formatLearnerDate(learner.lastLoginAt) },
			{ label: 'Expiration', value: formatLearnerDate(learner.expirationAt) },
			{ label: 'Bloqué le', value: formatLearnerDate(learner.blockedAt) },
		]
	: [];
---

<section
	class="mb-8 scroll-mt-20"
	id="acces"
	aria-labelledby="teachizy-heading"
	data-action-zone
	data-enrollment={enrollmentId}
	data-name={displayName}
>
	<div class="flex flex-wrap items-center justify-between gap-2">
		<div class="flex min-w-0 flex-wrap items-center gap-2">
			<h2 id="teachizy-heading" class="text-lg font-medium text-ink">Teachizy</h2>
			<StatusBadge tone={detail.pipeline.acces.tone}>
				{ACCESS_STATUS_LABELS[detail.accessStatus]}
			</StatusBadge>
		</div>
		{
			actions.length > 0 ? (
				<div class="flex flex-wrap gap-2">
					{actions.map((action) => (
						<button type="button" data-action={action.action} class={btnBase}>
							{action.label}
						</button>
					))}
				</div>
			) : null
		}
	</div>
	{hint ? <p class="mt-2 text-sm text-ink-soft">{hint}</p> : null}

	<div class="mt-4 flex flex-wrap items-center gap-x-4">
		<details class="peer group">
			<summary
				class:list={[
					'cursor-pointer list-none',
					linkClass,
					'[&::-webkit-details-marker]:hidden',
				]}
			>
				<span class="group-open:hidden">Voir le détail</span>
				<span class="hidden group-open:inline">Masquer le détail</span>
			</summary>
		</details>
		<a
			href={TEACHIZY_ACADEMY_URL}
			target="_blank"
			rel="noopener noreferrer"
			class={linkClass}
		>
			Académie ↗
		</a>
		<div class="mt-3 hidden w-full basis-full peer-open:block">
			{
				teachizy.error ? (
					<p class="text-sm text-blush-deep">{teachizy.error}</p>
				) : !teachizy.configured ? (
					<p class="text-sm text-ink-soft">Teachizy n’est pas configuré.</p>
				) : !learner ? (
					<p class="text-sm text-ink-soft">
						Pas encore d’apprenant Teachizy pour cet e-mail.
					</p>
				) : (
					<dl class="grid gap-x-6 gap-y-2 sm:grid-cols-2">
						{rows.map((row) => (
							<div class="flex min-w-0 gap-2 text-sm">
								<dt class="shrink-0 text-ink/45">{row.label}</dt>
								<dd class="min-w-0 text-ink">{row.value}</dd>
							</div>
						))}
					</dl>
				)
			}
		</div>
	</div>
</section>
