---
import StatusBadge from '../../ui/StatusBadge.astro';
import type { AdminActionDef } from '../../../lib/admin/actions';
import type { AdminEnrollmentDetail } from '../../../lib/admin/enrollments';
import { ACCESS_STATUS_LABELS, TEACHIZY_ACADEMY_URL } from '../../../lib/status';
import {
	formatLearnerDate,
	formatLearnerDuration,
	learnerStatusLabel,
	learnerStatusTone,
	type AdminTeachizyLearnerResult,
} from '../../../lib/admin/teachizy-learners';

interface Props {
	detail: AdminEnrollmentDetail;
	enrollmentId: string;
	displayName: string;
	teachizy: AdminTeachizyLearnerResult;
	actions?: AdminActionDef[];
}

const { detail, enrollmentId, displayName, teachizy, actions = [] } = Astro.props;
const learner = teachizy.learner;

const btnBase =
	'inline-flex min-h-9 items-center justify-center border border-ink/20 bg-transparent px-3 text-sm font-medium text-ink transition-colors hover:border-ink/40 hover:bg-surface/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';

const linkClass =
	'text-sm text-ink-soft underline underline-offset-2 hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';

let hint: string | null = null;
if (detail.contractStatus !== 'signed') {
	hint = 'Après signature du contrat de confidentialité';
} else if (detail.accessStatus === 'suspended') {
	hint = 'Coupé — réinvitez si paiement OK';
}

const detailRows = learner
	? [
			{
				label: 'Compte',
				value:
					learner.accountStatus === 'DISABLED'
						? 'Désactivé'
						: learner.accountStatus === 'ACTIVE'
							? 'Actif'
							: '—',
			},
			{ label: 'Formation', value: learner.trainingName ?? '—' },
			{ label: 'Temps passé', value: formatLearnerDuration(learner.durationSeconds) },
			{
				label: 'Quiz',
				value: learner.quizPercent == null ? '—' : `${Math.round(learner.quizPercent)} %`,
			},
			{ label: 'Inscrit le', value: formatLearnerDate(learner.enrolledAt) },
			{ label: 'Commencé le', value: formatLearnerDate(learner.startedAt) },
			{ label: 'Terminé le', value: formatLearnerDate(learner.completedAt) },
			{ label: 'Expiration', value: formatLearnerDate(learner.expirationAt) },
			{ label: 'Bloqué le', value: formatLearnerDate(learner.blockedAt) },
		]
	: [];
---

<section
	class="mb-8 scroll-mt-20"
	id="acces"
	aria-labelledby="teachizy-heading"
	data-action-zone
	data-enrollment={enrollmentId}
	data-name={displayName}
>
	<div class="flex flex-wrap items-center justify-between gap-2">
		<div class="flex min-w-0 flex-wrap items-center gap-2">
			<h2 id="teachizy-heading" class="text-ink text-lg font-medium">Teachizy</h2>
			<StatusBadge tone={detail.pipeline.acces.tone}>
				{ACCESS_STATUS_LABELS[detail.accessStatus]}
			</StatusBadge>
		</div>
		{
			actions.length > 0 ? (
				<div class="flex flex-wrap gap-2">
					{actions.map((action) => (
						<button type="button" data-action={action.action} class={btnBase}>
							{action.label}
						</button>
					))}
				</div>
			) : null
		}
	</div>
	{hint ? <p class="text-ink-soft mt-2 text-sm">{hint}</p> : null}

	{
		teachizy.error ? (
			<p class="text-blush-deep mt-3 text-sm">{teachizy.error}</p>
		) : !teachizy.configured ? (
			<p class="text-ink-soft mt-3 text-sm">Teachizy n’est pas configuré.</p>
		) : !learner ? (
			<p class="text-ink-soft mt-3 text-sm">Pas encore d’apprenant Teachizy pour cet e-mail.</p>
		) : (
			<dl class="mt-3 grid w-full gap-x-6 gap-y-2 sm:grid-cols-2">
				<div class="flex min-w-0 gap-2 text-sm">
					<dt class="text-ink/45 shrink-0">Statut</dt>
					<dd class="text-ink min-w-0">
						<div class="flex flex-wrap items-center gap-1.5">
							{learner.trainingStatus === 'not_started' ? (
								learnerStatusLabel(learner.trainingStatus)
							) : (
								<StatusBadge tone={learnerStatusTone(learner.trainingStatus)}>
									{learnerStatusLabel(learner.trainingStatus)}
								</StatusBadge>
							)}
							{learner.accountStatus === 'DISABLED' && (
								<StatusBadge tone="action">Désactivé</StatusBadge>
							)}
						</div>
					</dd>
				</div>
				<div class="flex min-w-0 gap-2 text-sm">
					<dt class="text-ink/45 shrink-0">Progression</dt>
					<dd class="text-ink min-w-0">
						<div class="flex items-baseline gap-2">
							<span class="tabular-nums">{learner.progressionPercent} %</span>
							<span class="text-ink/45 text-[11px]">
								{learner.itemsCompleted}/{learner.itemsTotal}
							</span>
						</div>
						<div class="bg-ink/10 mt-1.5 h-0.5 w-full max-w-32" aria-hidden="true">
							<div
								class="bg-ink/55 h-0.5"
								style={`width: ${Math.min(100, learner.progressionPercent)}%`}
							/>
						</div>
						{learner.durationSeconds > 0 ? (
							<p class="text-ink/45 mt-1 text-[11px]">
								{formatLearnerDuration(learner.durationSeconds)}
							</p>
						) : null}
					</dd>
				</div>
				<div class="flex min-w-0 gap-2 text-sm">
					<dt class="text-ink/45 shrink-0">Activité</dt>
					<dd class="text-ink min-w-0 tabular-nums">{formatLearnerDate(learner.lastActivityAt)}</dd>
				</div>
				<div class="flex min-w-0 gap-2 text-sm">
					<dt class="text-ink/45 shrink-0">Connexion</dt>
					<dd class="text-ink min-w-0 tabular-nums">{formatLearnerDate(learner.lastLoginAt)}</dd>
				</div>
			</dl>
		)
	}

	<div class="mt-4 flex flex-wrap items-center gap-x-4">
		{
			learner ? (
				<details class="peer group">
					<summary
						class:list={[
							'cursor-pointer list-none',
							linkClass,
							'[&::-webkit-details-marker]:hidden',
						]}
					>
						<span class="group-open:hidden">Voir le détail</span>
						<span class="hidden group-open:inline">Masquer le détail</span>
					</summary>
				</details>
			) : null
		}
		<a href={TEACHIZY_ACADEMY_URL} target="_blank" rel="noopener noreferrer" class={linkClass}>
			Académie ↗
		</a>
		{
			learner ? (
				<dl class="mt-3 hidden w-full basis-full gap-x-6 gap-y-2 peer-open:grid sm:grid-cols-2">
					{detailRows.map((row) => (
						<div class="flex min-w-0 gap-2 text-sm">
							<dt class="text-ink/45 shrink-0">{row.label}</dt>
							<dd class="text-ink min-w-0">{row.value}</dd>
						</div>
					))}
				</dl>
			) : null
		}
	</div>
</section>
