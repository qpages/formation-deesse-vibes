---
import { activeFilterChips } from '../../../lib/admin/filter-labels';
import { adminListHref } from '../../../lib/admin/enrollments';
import type {
	AccessStatus,
	CollectionStatus,
	ContractStatus,
} from '../../../generated/prisma/client';

interface Props {
	q: string;
	collection: string;
	contract: string;
	access: string;
}

const { q, collection, contract, access } = Astro.props;

const chips = activeFilterChips({
	q,
	collection: collection as CollectionStatus | '',
	contract: contract as ContractStatus | '',
	access: access as AccessStatus | '',
});

const clearAllHref = adminListHref({ q });
---

{
	chips.length > 0 ? (
		<div class="flex flex-wrap items-center gap-2" aria-label="Filtres actifs">
			<span class="text-ink/45 text-[10px] tracking-[0.12em] uppercase">Actifs</span>
			{chips.map((chip) => (
				<a
					href={chip.href}
					class="border-ink/15 text-ink-soft hover:border-ink/30 hover:text-ink inline-flex items-center gap-1.5 border bg-white/80 px-2.5 py-1 text-[11px] transition-colors"
					title="Retirer ce filtre"
				>
					{chip.label}
					<span class="text-ink/35" aria-hidden="true">
						×
					</span>
				</a>
			))}
			{chips.length > 1 ? (
				<a
					href={clearAllHref}
					class="text-ink-soft hover:text-ink text-[11px] underline underline-offset-2"
				>
					Tout effacer
				</a>
			) : null}
		</div>
	) : null
}
