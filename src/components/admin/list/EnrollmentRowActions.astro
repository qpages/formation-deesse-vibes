---
import type { AdminEnrollmentRow } from '../../../lib/admin/enrollments';
import { METIER_ACTIONS, ZONE_ACTIONS } from '../../../lib/admin/actions';

interface Props {
	row: AdminEnrollmentRow;
	compact?: boolean;
}

const { row, compact = true } = Astro.props;

const allowed = new Set(row.visibleActions);
const metier = METIER_ACTIONS.filter((a) => allowed.has(a.action));
const actions = ZONE_ACTIONS.filter((a) => allowed.has(a.action));

const linkClass = compact
	? 'inline-flex min-h-9 items-center text-xs text-ink-soft underline underline-offset-2 transition-colors hover:text-blush-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush'
	: 'inline-flex min-h-11 items-center text-sm text-ink-soft underline underline-offset-2 transition-colors hover:text-blush-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';
const actionsLinkClass = compact
	? 'inline-flex min-h-9 items-center text-xs text-ink/50 underline underline-offset-2 transition-colors hover:text-ink-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush'
	: 'inline-flex min-h-11 items-center text-sm text-ink/50 underline underline-offset-2 transition-colors hover:text-ink-soft focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blush';
const zoneLabelClass = 'text-xs font-medium uppercase tracking-[0.12em] text-ink/55';
---

{
	metier.length + actions.length === 0 ? (
		<span class="text-ink/35 text-xs">—</span>
	) : (
		<div class="space-y-2" data-action-zone data-enrollment={row.id} data-name={row.displayName}>
			{metier.length > 0 ? (
				<div>
					{!compact ? <p class:list={['mb-2', zoneLabelClass]}>Métier</p> : null}
					<div class="flex flex-wrap gap-x-3 gap-y-1">
						{metier.map(({ action, label }) => (
							<button type="button" data-action={action} class={linkClass}>
								{label}
							</button>
						))}
					</div>
				</div>
			) : null}
			{actions.length > 0 ? (
				<div>
					<p class:list={[compact ? 'mt-1' : 'mb-2', zoneLabelClass]}>Actions</p>
					<div class="flex flex-wrap gap-x-3 gap-y-1">
						{actions.map(({ action, label }) => (
							<button type="button" data-action={action} class={actionsLinkClass}>
								{label}
							</button>
						))}
					</div>
				</div>
			) : null}
		</div>
	)
}
