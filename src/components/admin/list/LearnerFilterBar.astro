---
import Input from '../../ui/Input.astro';
import Button from '../../ui/Button.astro';
import type { TeachizyAccountStatus } from '../../../lib/teachizy';

interface Props {
	q: string;
	status: TeachizyAccountStatus | '';
}

const { q, status } = Astro.props;

const selectClass =
	'h-10 border border-ink/15 bg-transparent px-2 text-sm text-ink outline-none hover:border-ink/30 focus:border-ink/40';
---

<form
	id="admin-learners-filters"
	method="get"
	action="/admin/apprenants"
	class="flex flex-col gap-3"
	role="search"
>
	<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
		<label class="sr-only" for="admin-learner-search">Rechercher un apprenant</label>
		<Input
			type="search"
			name="q"
			id="admin-learner-search"
			value={q}
			placeholder="E-mail, prénom ou nom…"
			autocomplete="off"
			class="h-11 sm:max-w-md"
		/>
		<Button type="submit" variant="secondary" size="sm" class="h-11 shrink-0 px-5">
			Rechercher
		</Button>
	</div>

	<label class="flex w-full max-w-56 flex-col gap-1">
		<span class="text-ink/45 text-[10px] tracking-[0.12em] uppercase">Compte</span>
		<select
			name="status"
			class={selectClass}
			aria-label="Filtrer par statut de compte"
			data-filter-auto
		>
			<option value="" selected={status === ''}>Tous</option>
			<option value="ACTIVE" selected={status === 'ACTIVE'}>Actif</option>
			<option value="DISABLED" selected={status === 'DISABLED'}>Désactivé</option>
		</select>
	</label>
</form>

<script>
	document.querySelectorAll('[data-filter-auto]').forEach((select) => {
		select.addEventListener('change', () => {
			const form = select.closest('form');
			form?.requestSubmit();
		});
	});
</script>
