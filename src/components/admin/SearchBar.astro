---
import Input from '../ui/Input.astro';
import Button from '../ui/Button.astro';

interface Props {
	q: string;
	placeholder?: string;
}

const { q, placeholder = 'E-mail, prénom ou nom…' } = Astro.props;
---

<form method="get" action="/admin" class="flex flex-col gap-2 sm:flex-row sm:items-center" role="search">
	<label class="sr-only" for="admin-search">Rechercher une inscription</label>
	<Input
		type="search"
		name="q"
		id="admin-search"
		value={q}
		placeholder={placeholder}
		autocomplete="off"
		class="h-11 sm:max-w-md"
	/>
	<div class="flex items-center gap-2">
		<Button type="submit" variant="secondary" size="sm" class="h-11 px-5">
			Rechercher
		</Button>
		{
			q ? (
				<a
					href="/admin"
					class="text-sm text-ink-soft underline underline-offset-2 hover:text-ink"
				>
					Effacer
				</a>
			) : null
		}
	</div>
</form>
