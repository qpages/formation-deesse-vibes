---
import Dialog from '../ui/Dialog.astro';
import Button from '../ui/Button.astro';
---

<Dialog id="payment-detail-dialog" title="Paiements" size="lg">
	<div id="payment-dialog-content"></div>
	<div slot="footer">
		<Button type="button" variant="secondary" size="sm" id="payment-dialog-close">
			Fermer
		</Button>
	</div>
</Dialog>

<script>
	type PaymentStatus = 'paid' | 'open' | 'failed' | 'void' | 'uncollectible' | 'draft';
	type BadgeTone = 'neutral' | 'progress' | 'success' | 'action';

	type PaymentRow = {
		installmentNumber: number;
		amountLabel: string;
		status: PaymentStatus;
		statusLabel: string;
		failureReason: string | null;
		dueAt: string | null;
		paidAt: string | null;
		stripeUrl: string | null;
		invoicePdfUrl: string | null;
		hostedInvoiceUrl: string | null;
	};

	type InvoiceLink = {
		installmentNumber: number;
		amountLabel: string;
		paidAt: string | null;
		pdfUrl: string | null;
		hostedUrl: string | null;
	};

	type PaymentSummary = {
		planLabel: string;
		progressLabel: string;
		trackingLabel: string;
		trackingTone: BadgeTone;
		trackingState: 'en_attente' | 'a_jour' | 'impaye' | 'termine' | 'rembourse';
		nextInstallmentDueAt: string | null;
		collectedAmountCents: number;
		totalAmountCents: number | null;
		installmentsPaid: number;
		installmentsTotal: number | null;
		stripeSubscriptionUrl: string | null;
		stripeScheduleUrl: string | null;
		invoices: InvoiceLink[];
		payments: PaymentRow[];
	};

	const dialog = document.getElementById('payment-detail-dialog') as HTMLDialogElement | null;
	const content = document.getElementById('payment-dialog-content');
	const closeBtn = document.getElementById('payment-dialog-close');
	const titleEl = dialog?.querySelector<HTMLElement>('[data-dialog-title]');
	const descEl = dialog?.querySelector<HTMLElement>('[data-dialog-description]');
	const eyebrowEl = dialog?.querySelector<HTMLElement>('[data-dialog-eyebrow]');

	const badgeToneClass: Record<BadgeTone, string> = {
		neutral: 'border-ink/12 bg-ink/5 text-ink/45',
		progress: 'border-gold/45 bg-gold/25 text-ink',
		success: 'border-sage/40 bg-sage/20 text-sage',
		action: 'border-blush/40 bg-blush/15 text-blush-deep',
	};

	const paymentStatusTone: Record<PaymentStatus, BadgeTone> = {
		paid: 'success',
		open: 'progress',
		failed: 'action',
		uncollectible: 'action',
		void: 'neutral',
		draft: 'neutral',
	};

	function formatMoney(cents: number) {
		return new Intl.NumberFormat('fr-FR', {
			style: 'currency',
			currency: 'EUR',
		}).format(cents / 100);
	}

	function formatDate(iso: string | null, withTime = false) {
		if (!iso) return null;
		return new Date(iso).toLocaleString('fr-FR', {
			dateStyle: 'short',
			...(withTime ? { timeStyle: 'short' } : {}),
		});
	}

	function badge(label: string, tone: BadgeTone) {
		return `<span class="inline-flex max-w-full items-center whitespace-nowrap rounded-sm border px-2 py-0.5 text-[10px] font-medium uppercase tracking-[0.08em] ${badgeToneClass[tone]}">${label}</span>`;
	}

	function externalLink(href: string, label: string) {
		return `<a href="${href}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[12px] text-ink-soft underline-offset-2 hover:text-ink hover:underline">${label}<svg class="size-3 opacity-50" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3.5 2.5H9.5V8.5M9.5 2.5L2.5 9.5" stroke="currentColor" stroke-width="1.25"/></svg></a>`;
	}

	function allInstallments(summary: PaymentSummary): PaymentRow[] {
		const total = summary.installmentsTotal ?? Math.max(summary.payments.length, 1);
		const byNumber = new Map(summary.payments.map((p) => [p.installmentNumber, p]));
		const remainingCents = Math.max(
			0,
			(summary.totalAmountCents ?? summary.collectedAmountCents) - summary.collectedAmountCents,
		);
		const remainingSlots = Math.max(0, total - summary.installmentsPaid);
		const estimatedCents =
			remainingSlots > 0 ? Math.round(remainingCents / remainingSlots) : 0;

		const rows: PaymentRow[] = [];
		let assignedNextDue = false;

		for (let n = 1; n <= total; n++) {
			const existing = byNumber.get(n);
			if (existing) {
				rows.push(existing);
				if (existing.status !== 'paid' && existing.dueAt) assignedNextDue = true;
				continue;
			}

			const dueAt =
				!assignedNextDue && summary.nextInstallmentDueAt
					? summary.nextInstallmentDueAt
					: null;
			if (dueAt) assignedNextDue = true;

			rows.push({
				installmentNumber: n,
				amountLabel: formatMoney(estimatedCents),
				status: 'open',
				statusLabel: 'À venir',
				failureReason: null,
				dueAt,
				paidAt: null,
				stripeUrl: null,
				invoicePdfUrl: null,
				hostedInvoiceUrl: null,
			});
		}

		return rows;
	}

	function renderInvoiceRow(invoice: InvoiceLink) {
		const paid = formatDate(invoice.paidAt, true);
		const pdf = invoice.pdfUrl
			? externalLink(invoice.pdfUrl, 'PDF')
			: '';
		const hosted = invoice.hostedUrl
			? externalLink(invoice.hostedUrl, 'Voir')
			: '';
		const links = [pdf, hosted].filter(Boolean);

		return `<li class="flex items-start gap-3 py-3">
			<span class="mt-0.5 w-5 shrink-0 text-[11px] font-medium text-ink/40">${invoice.installmentNumber}</span>
			<div class="min-w-0 flex-1">
				<p class="font-medium text-ink">${invoice.amountLabel}</p>
				<p class="mt-1 text-[12px] text-ink-soft">${paid ? `Payée le ${paid}` : 'Facture disponible'}</p>
			</div>
			${
				links.length
					? `<div class="mt-0.5 flex shrink-0 items-center gap-3">${links.join('')}</div>`
					: ''
			}
		</li>`;
	}

	function renderInstallmentRow(p: PaymentRow) {
		const paid = formatDate(p.paidAt, true);
		const due = formatDate(p.dueAt);
		const meta = paid
			? `Payé le ${paid}`
			: due
				? `Échéance ${due}`
				: 'Date à venir';
		const tone = paymentStatusTone[p.status] ?? 'neutral';
		const invoiceHref = p.invoicePdfUrl ?? p.hostedInvoiceUrl;

		return `<li class="flex items-start gap-3 py-3.5">
			<span class="mt-0.5 w-5 shrink-0 text-[11px] font-medium text-ink/40">${p.installmentNumber}</span>
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
					<span class="font-medium text-ink">${p.amountLabel}</span>
					${badge(p.statusLabel, tone)}
				</div>
				<p class="mt-1 text-[12px] text-ink-soft">${meta}</p>
				${p.failureReason ? `<p class="mt-1 text-[12px] text-blush-deep">${p.failureReason}</p>` : ''}
				${
					invoiceHref
						? `<p class="mt-1.5">${externalLink(invoiceHref, 'Télécharger la facture')}</p>`
						: ''
				}
			</div>
			${
				p.stripeUrl
					? `<a href="${p.stripeUrl}" target="_blank" rel="noopener noreferrer" class="mt-0.5 shrink-0 text-[11px] text-ink/40 underline-offset-2 hover:text-ink hover:underline" aria-label="Ouvrir l’échéance ${p.installmentNumber} dans Stripe">Stripe</a>`
					: `<span class="mt-0.5 shrink-0 text-[11px] text-ink/25">—</span>`
			}
		</li>`;
	}

	function renderSummary(name: string, summary: PaymentSummary) {
		if (!content || !titleEl || !descEl || !eyebrowEl) return;

		const total = summary.installmentsTotal ?? 1;
		const collected = formatMoney(summary.collectedAmountCents);
		const totalLabel =
			summary.totalAmountCents != null ? formatMoney(summary.totalAmountCents) : null;
		const nextDue = formatDate(summary.nextInstallmentDueAt);
		const showNextDue =
			Boolean(nextDue) &&
			summary.trackingState !== 'termine' &&
			summary.trackingState !== 'rembourse';
		const installments = allInstallments(summary);
		const invoices = summary.invoices ?? [];

		eyebrowEl.textContent = summary.planLabel;
		titleEl.textContent = name;
		descEl.textContent = '';

		const stripeLinks = [
			summary.stripeSubscriptionUrl
				? externalLink(summary.stripeSubscriptionUrl, 'Abonnement')
				: '',
			summary.stripeScheduleUrl ? externalLink(summary.stripeScheduleUrl, 'Schedule') : '',
		].filter(Boolean);

		const invoiceSection =
			invoices.length === 0
				? `<p class="border-t border-dashed border-ink/15 py-4 text-[13px] text-ink-soft">Aucune facture disponible pour le moment.</p>`
				: `<ul class="divide-y divide-ink/10 border-t border-ink/10">${invoices
						.map(renderInvoiceRow)
						.join('')}</ul>`;

		const installmentRows =
			installments.length === 0
				? `<p class="border-t border-dashed border-ink/15 py-6 text-center text-sm text-ink-soft">Aucune échéance.</p>`
				: `<ul class="divide-y divide-ink/10 border-t border-ink/10">${installments
						.map(renderInstallmentRow)
						.join('')}</ul>`;

		content.innerHTML = `
			<div class="space-y-5">
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="min-w-0">
						<p class="font-display text-2xl leading-none tracking-tight text-ink">${collected}${
							totalLabel
								? `<span class="text-base font-sans font-normal text-ink/35"> / ${totalLabel}</span>`
								: ''
						}</p>
						<p class="mt-2 text-[12px] text-ink-soft">${summary.installmentsPaid}/${total} échéance${total > 1 ? 's' : ''}${
							showNextDue ? ` · prochaine le ${nextDue}` : ''
						}</p>
					</div>
					${badge(summary.trackingLabel, summary.trackingTone)}
				</div>

				${
					stripeLinks.length
						? `<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
							<span class="text-[10px] uppercase tracking-[0.12em] text-ink/40">Stripe</span>
							${stripeLinks.join('<span class="text-ink/20" aria-hidden="true">·</span>')}
						</div>`
						: ''
				}

				<div>
					<p class="mb-1 text-[10px] uppercase tracking-[0.12em] text-ink/40">Factures</p>
					${invoiceSection}
				</div>

				<div>
					<p class="mb-1 text-[10px] uppercase tracking-[0.12em] text-ink/40">Échéances</p>
					${installmentRows}
				</div>
			</div>
		`;
	}

	async function openPaymentDetail(enrollmentId: string, name: string) {
		if (!dialog) return;

		if (eyebrowEl) eyebrowEl.textContent = '';
		if (titleEl) titleEl.textContent = name || 'Paiements';
		if (descEl) descEl.textContent = '';
		if (content) {
			content.innerHTML =
				'<p class="py-6 text-center text-sm text-ink-soft">Chargement…</p>';
		}

		dialog.showModal();

		try {
			const res = await fetch(`/api/admin/enrollment/${enrollmentId}/payments`);
			const json = await res.json();
			if (!res.ok) throw new Error(json.error || 'Erreur');
			renderSummary(name, json.summary as PaymentSummary);
		} catch (error) {
			if (content) {
				content.innerHTML = `<p class="py-6 text-center text-sm text-blush-deep">${
					error instanceof Error ? error.message : 'Impossible de charger les paiements.'
				}</p>`;
			}
		}
	}

	document.querySelectorAll('.payment-detail-trigger').forEach((btn) => {
		btn.addEventListener('click', () => {
			const enrollmentId = btn.getAttribute('data-enrollment');
			const name = btn.getAttribute('data-name') ?? '';
			if (!enrollmentId) return;
			void openPaymentDetail(enrollmentId, name);
		});
	});

	closeBtn?.addEventListener('click', () => dialog?.close());
	dialog?.querySelector('[data-dialog-close]')?.addEventListener('click', () => dialog?.close());
</script>
