---
interface Props {
	items: Array<{
		id: string;
		actionLabel: string;
		adminEmail: string;
		createdAt: Date;
	}>;
}

const { items } = Astro.props;
---

<section class="space-y-3">
	<h2 class="font-display text-2xl text-ink">Historique</h2>
	{
		items.length === 0 ? (
			<p class="border border-dashed border-ink/15 px-4 py-6 text-sm text-ink-soft">
				Aucune action admin pour le moment.
			</p>
		) : (
			<ol class="divide-y divide-ink/10 border border-ink/10">
				{items.map((item) => (
					<li class="flex flex-wrap items-baseline justify-between gap-2 px-4 py-3">
						<div class="min-w-0">
							<p class="font-medium text-ink">{item.actionLabel}</p>
							<p class="text-[12px] text-ink-soft">{item.adminEmail}</p>
						</div>
						<time
							class="shrink-0 text-[11px] text-ink/45"
							datetime={item.createdAt.toISOString()}
						>
							{item.createdAt.toLocaleString('fr-FR', {
								dateStyle: 'short',
								timeStyle: 'short',
							})}
						</time>
					</li>
				))}
			</ol>
		)
	}
</section>
