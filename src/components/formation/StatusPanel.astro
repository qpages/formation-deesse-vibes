---
import type { Enrollment } from '../../generated/prisma/client';
import { primaryAction, statusMessage } from '../../lib/status';
import Alert from '../ui/Alert.astro';
import Button from '../ui/Button.astro';
import SignLinkCard from './SignLinkCard.astro';

interface Props {
	enrollment: Enrollment;
	ndaSignUrl?: string | null;
	flash?: string | null;
}

const { enrollment, ndaSignUrl, flash } = Astro.props;
const action = primaryAction(enrollment.status, ndaSignUrl);
const message = statusMessage(enrollment.status);
const panelTitle =
	enrollment.status === 'teachizy_envoye' ? 'Accès prêt' : 'Votre inscription';
const canResend =
	enrollment.status === 'nda_envoye' || enrollment.status === 'paiement_confirme';
const showSignCard = Boolean(ndaSignUrl);
---

<div class="space-y-6">
	<div class="flex flex-wrap items-center gap-3">
		<h3 class="font-display text-3xl text-ink">{panelTitle}</h3>
	</div>

	{
		flash && (
			<Alert variant="success">{flash}</Alert>
		)
	}

	{
		enrollment.status === 'paiement_en_attente' && enrollment.stripeCheckoutSessionId && (
			<p class="text-ink-soft">
				Paiement en cours de confirmation. Rechargez cette page dans un instant.
			</p>
		)
	}
	{
		enrollment.status === 'paiement_confirme' && !showSignCard && (
			<p class="text-ink-soft">
				Paiement confirmé. Votre lien de signature apparaît ici dès qu’il est prêt —
				rechargez la page dans un instant.
			</p>
		)
	}
	{
		enrollment.status === 'nda_envoye' && !showSignCard && (
			<p class="text-ink-soft">
				Votre accord est prêt, mais le lien n’est pas encore disponible. Actualisez la page
				ou contactez un administrateur.
			</p>
		)
	}
	{message && <p class="text-ink-soft">{message}</p>}
	{
		(enrollment.status === 'rembourse' || enrollment.status === 'acces_retire') && (
			<Alert variant="info">
				Cette inscription est clôturée. Contactez un administrateur si besoin.
			</Alert>
		)
	}

	{showSignCard && ndaSignUrl && <SignLinkCard signUrl={ndaSignUrl} />}

	{
		!showSignCard && (
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center">
				{action.kind === 'refresh' && (
					<Button href="/" size="lg" variant="primary">
						{action.label}
					</Button>
				)}
				{action.kind === 'open_platform' && (
					<Button
						href={action.href}
						size="lg"
						variant="primary"
						target="_blank"
						rel="noopener noreferrer"
					>
						{action.label}
					</Button>
				)}
			</div>
		)
	}

	{
		canResend && (
			<button
				id="resend-nda"
				type="button"
				class="text-sm text-ink-soft underline-offset-4 hover:text-ink hover:underline"
			>
				Renvoyer l’accord de confidentialité
			</button>
		)
	}
	<p id="resend-feedback" class="hidden text-sm text-ink-soft"></p>
</div>

<script>
	const btn = document.getElementById('resend-nda');
	const feedback = document.getElementById('resend-feedback');
	btn?.addEventListener('click', async () => {
		if (!btn || !feedback) return;
		btn.setAttribute('disabled', 'true');
		feedback.classList.remove('hidden');
		feedback.textContent = 'Envoi en cours…';
		try {
			const res = await fetch('/api/nda/resend', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({}),
			});
			const json = await res.json();
			feedback.textContent = res.ok ? json.message : json.error;
		} catch {
			feedback.textContent = 'Impossible de renvoyer pour le moment.';
		} finally {
			btn.removeAttribute('disabled');
		}
	});
</script>
