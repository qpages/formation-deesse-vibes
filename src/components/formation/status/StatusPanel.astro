---
import type { Enrollment } from '../../../generated/prisma/client';
import { resolveSignatureStatusCopy } from '../../../lib/signature/helpers';
import type { SignSurface } from '../../../lib/signature/types';
import {
	ENROLLMENT_POLL_INTERVAL_MS,
	ENROLLMENT_POLL_MAX_MS,
	shouldPollEnrollment,
} from '../../../lib/status';
import {
	buildStatusPanelView,
	enrollmentFingerprint,
} from '../../../lib/enrollment/status-payload';
import Alert from '../../ui/Alert.astro';
import Button from '../../ui/Button.astro';
import DocusealEmbedCard from './DocusealEmbedCard.astro';
import SignLinkCard from './SignLinkCard.astro';

interface Props {
	enrollment: Enrollment;
	ndaSignSurface?: SignSurface | null;
}

const { enrollment, ndaSignSurface = null } = Astro.props;
const signatureStatusCopy = resolveSignatureStatusCopy();
const orthogonal = {
	collectionStatus: enrollment.collectionStatus,
	contractStatus: enrollment.contractStatus,
	accessStatus: enrollment.accessStatus,
};
const view = buildStatusPanelView(enrollment, ndaSignSurface);
const poll = shouldPollEnrollment({
	...orthogonal,
	hasCheckoutSession: Boolean(enrollment.stripeCheckoutSessionId),
	hasNdaSignSurface: view.showSignSurfaceReady,
});
const pollFingerprint = enrollmentFingerprint(orthogonal);
---

<div
	class="space-y-4"
	id="status-panel"
	data-fingerprint={pollFingerprint}
	data-poll={poll ? 'true' : 'false'}
	data-poll-interval={ENROLLMENT_POLL_INTERVAL_MS}
	data-poll-max={ENROLLMENT_POLL_MAX_MS}
	data-collection-status={enrollment.collectionStatus}
	data-contract-status={enrollment.contractStatus}
	data-access-status={enrollment.accessStatus}
	data-sign-surface={view.showSignSurfaceReady ? 'true' : 'false'}
	data-sign-surface-kind={ndaSignSurface?.kind ?? ''}
	data-sign-surface-provider={ndaSignSurface?.kind === 'embed' ? ndaSignSurface.provider : ''}
>
	<p id="status-sign-ready" class:list={['text-ink-soft', !view.showSignSurfaceReady && 'hidden']}>
		{signatureStatusCopy.signSurfaceReady}
	</p>

	<p
		id="status-payment-pending"
		class:list={['text-ink-soft', !view.showPaymentPending && 'hidden']}
	>
		Paiement en cours de confirmation. Cette page se met à jour automatiquement.
	</p>

	<p id="status-sign-waiting" class:list={['text-ink-soft', !view.showSignWaiting && 'hidden']}>
		{signatureStatusCopy.signSurfaceWaiting}
	</p>

	<p
		id="status-sign-unavailable"
		class:list={['text-ink-soft', !view.showSignUnavailable && 'hidden']}
	>
		{signatureStatusCopy.signSurfaceUnavailable}
	</p>

	<div id="status-message-block">
		{
			!view.showSignSurfaceReady && view.action.kind === 'open_platform'
				? view.message && (
						<div class="max-w-prose space-y-1.5">
							<p class="text-ink-soft text-lg leading-snug font-normal sm:text-xl">
								{view.message[0]}
							</p>
							{view.message[1] && (
								<p class="text-ink-soft text-sm leading-relaxed sm:text-[0.9375rem]">
									{view.message[1]}
								</p>
							)}
						</div>
					)
				: view.message && (
						<div class="max-w-prose space-y-1.5">
							{view.message.map((line) => (
								<p class="text-ink-soft text-sm">{line}</p>
							))}
						</div>
					)
		}
	</div>

	<div id="status-action-block">
		{
			!view.showSignSurfaceReady && view.action.kind === 'open_platform' && (
				<Button
					href={view.action.href}
					size="md"
					variant="primary"
					target="_blank"
					rel="noopener noreferrer"
					class="w-full whitespace-nowrap sm:w-auto"
				>
					{view.action.label}
				</Button>
			)
		}
		{
			!view.showSignSurfaceReady && view.action.kind === 'refresh' && (
				<Button
					href="/#acces"
					size="md"
					variant="primary"
					id="status-refresh"
					class="w-full whitespace-nowrap sm:w-auto"
				>
					{view.action.label}
				</Button>
			)
		}
	</div>

	<div id="status-closed-alert" class:list={[!view.closed && 'hidden']}>
		{
			view.closed && (
				<Alert variant="info">
					Cette inscription est clôturée. Contactez un administrateur si besoin.
				</Alert>
			)
		}
	</div>

	<div id="status-sign-surface" class:list={[!view.showSignSurfaceReady && 'hidden']}>
		{ndaSignSurface?.kind === 'redirect' && <SignLinkCard signUrl={ndaSignSurface.url} />}
		{
			ndaSignSurface?.kind === 'embed' && ndaSignSurface.provider === 'docuseal' && (
				<DocusealEmbedCard src={ndaSignSurface.src} email={ndaSignSurface.email} />
			)
		}
		{
			ndaSignSurface?.kind === 'embed' && ndaSignSurface.provider !== 'docuseal' && (
				<Alert variant="info">
					La signature est prête. Actualisez cette page ou contactez-nous si le formulaire ne
					s’affiche pas.
				</Alert>
			)
		}
	</div>

	<div id="status-nda-confirm" class:list={['space-y-3', !view.showNdaConfirm && 'hidden']}>
		{
			view.showNdaConfirm && (
				<>
					<p class="text-ink-soft text-sm">
						Après signature, cette page se met à jour automatiquement. Si ce n’est pas le cas,
						cliquez ci-dessous.
					</p>
					<Button
						id="nda-confirm-signed"
						type="button"
						size="md"
						variant="secondary"
						class="w-full whitespace-nowrap sm:w-auto"
					>
						J’ai signé le contrat de confidentialité
					</Button>
					<p id="nda-confirm-feedback" class="text-ink-soft text-sm" aria-live="polite" />
				</>
			)
		}
	</div>
</div>

<script>
	import { lockButton } from '../../../lib/client/lock-button';
	import {
		refreshEnrollmentAfterNdaSigned,
		reloadEnrollmentStatus,
		startEnrollmentPolling,
	} from '../../../lib/client/enrollment-status-client';
	import { requestNdaSignatureRefresh } from '../../../lib/client/refresh-nda-signature';

	document.getElementById('status-refresh')?.addEventListener('click', (event) => {
		event.preventDefault();
		reloadEnrollmentStatus();
	});

	const confirmBtn = document.getElementById('nda-confirm-signed') as HTMLButtonElement | null;
	const confirmFeedback = document.getElementById('nda-confirm-feedback');

	confirmBtn?.addEventListener('click', async () => {
		if (!confirmBtn) return;
		const lock = lockButton(confirmBtn, { busyLabel: 'Vérification…' });
		if (!lock.locked) return;
		if (confirmFeedback) confirmFeedback.textContent = '';
		try {
			const result = await requestNdaSignatureRefresh();
			if (result.signed) {
				await refreshEnrollmentAfterNdaSigned();
				return;
			}
			if (confirmFeedback) confirmFeedback.textContent = result.message;
		} catch {
			if (confirmFeedback) {
				confirmFeedback.textContent =
					'Impossible de vérifier la signature pour le moment. Réessaie dans quelques secondes.';
			}
		}
		lock.unlock();
	});

	const panel = document.getElementById('status-panel');
	if (panel) startEnrollmentPolling(panel);
</script>
