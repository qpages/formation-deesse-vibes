---
import type { Enrollment } from '../../../generated/prisma/client';
import { resolveSignatureStatusCopy } from '../../../lib/signature/helpers';
import type { SignSurface } from '../../../lib/signature/types';
import { isPaidEnough } from '../../../lib/enrollment-gates';
import {
	ENROLLMENT_POLL_INTERVAL_MS,
	ENROLLMENT_POLL_MAX_MS,
	primaryAction,
	shouldPollEnrollment,
	statusMessage,
} from '../../../lib/status';
import Alert from '../../ui/Alert.astro';
import Button from '../../ui/Button.astro';
import DocusealEmbedCard from './DocusealEmbedCard.astro';
import SignLinkCard from './SignLinkCard.astro';

interface Props {
	enrollment: Enrollment;
	ndaSignSurface?: SignSurface | null;
}

const { enrollment, ndaSignSurface = null } = Astro.props;
const signatureStatusCopy = resolveSignatureStatusCopy();
const orthogonal = {
	collectionStatus: enrollment.collectionStatus,
	contractStatus: enrollment.contractStatus,
	accessStatus: enrollment.accessStatus,
};
const action = primaryAction(orthogonal, ndaSignSurface);
const message = statusMessage(orthogonal);
const showSignSurface = Boolean(ndaSignSurface);
const poll = shouldPollEnrollment({
	...orthogonal,
	hasCheckoutSession: Boolean(enrollment.stripeCheckoutSessionId),
	hasNdaSignSurface: showSignSurface,
});
const closed = enrollment.accessStatus === 'revoked' || enrollment.collectionStatus === 'refunded';
const pollFingerprint = `${enrollment.collectionStatus}|${enrollment.contractStatus}|${enrollment.accessStatus}`;
---

<div
	class="space-y-4"
	id="status-panel"
	data-fingerprint={pollFingerprint}
	data-poll={poll ? 'true' : 'false'}
	data-poll-interval={ENROLLMENT_POLL_INTERVAL_MS}
	data-poll-max={ENROLLMENT_POLL_MAX_MS}
>
	{showSignSurface && (
		<p class="text-ink-soft">{signatureStatusCopy.signSurfaceReady}</p>
	)}

	{
		enrollment.collectionStatus === 'pending' && enrollment.stripeCheckoutSessionId && (
			<p class="text-ink-soft">
				Paiement en cours de confirmation. Cette page se met à jour automatiquement.
			</p>
		)
	}
	{
		isPaidEnough(enrollment.collectionStatus) &&
			enrollment.contractStatus === 'pending' &&
			!showSignSurface && (
				<p class="text-ink-soft">{signatureStatusCopy.signSurfaceWaiting}</p>
			)
	}
	{
		enrollment.contractStatus === 'sent' && !showSignSurface && (
			<p class="text-ink-soft">{signatureStatusCopy.signSurfaceUnavailable}</p>
		)
	}
	{
		!showSignSurface && action.kind === 'open_platform' ? (
			<div class="max-w-prose space-y-4">
				{message && (
					<div class="space-y-1.5">
						<p class="text-ink-soft text-lg leading-snug font-normal sm:text-xl">{message[0]}</p>
						{message[1] && (
							<p class="text-ink-soft text-sm leading-relaxed sm:text-[0.9375rem]">{message[1]}</p>
						)}
					</div>
				)}
				<Button
					href={action.href}
					size="md"
					variant="primary"
					target="_blank"
					rel="noopener noreferrer"
					class="w-full whitespace-nowrap sm:w-auto"
				>
					{action.label}
				</Button>
			</div>
		) : (
			message && (
				<div class="max-w-prose space-y-1.5">
					{message.map((line) => (
						<p class="text-ink-soft text-sm">{line}</p>
					))}
				</div>
			)
		)
	}

	{
		!showSignSurface && action.kind === 'refresh' && (
			<Button
				href="/#acces"
				size="md"
				variant="primary"
				id="status-refresh"
				class="w-full whitespace-nowrap sm:w-auto"
			>
				{action.label}
			</Button>
		)
	}
	{
		closed && (
			<Alert variant="info">
				Cette inscription est clôturée. Contactez un administrateur si besoin.
			</Alert>
		)
	}

	{ndaSignSurface?.kind === 'redirect' && <SignLinkCard signUrl={ndaSignSurface.url} />}
	{ndaSignSurface?.kind === 'embed' && (
		<DocusealEmbedCard src={ndaSignSurface.src} email={ndaSignSurface.email} />
	)}

	{
		enrollment.contractStatus === 'sent' &&
			!closed &&
			ndaSignSurface?.kind === 'redirect' && (
				<div class="space-y-3">
					<p class="text-ink-soft text-sm">
						Après signature, cette page se met à jour automatiquement. Si ce n’est pas le cas, cliquez
						ci-dessous.
					</p>
					<Button
						id="nda-confirm-signed"
						type="button"
						size="md"
						variant="secondary"
						class="w-full whitespace-nowrap sm:w-auto"
					>
						J’ai signé le contrat de confidentialité
					</Button>
					<p id="nda-confirm-feedback" class="text-ink-soft text-sm" aria-live="polite" />
				</div>
			)
	}
</div>

<script>
	import { lockButton } from '../../../lib/client/lock-button';
	import { reloadAfterNdaSigned, syncNdaSignature } from '../../../lib/client/nda-sync';

	document.getElementById('status-refresh')?.addEventListener('click', (event) => {
		event.preventDefault();
		window.location.hash = 'acces';
		window.location.reload();
	});

	const confirmBtn = document.getElementById('nda-confirm-signed') as HTMLButtonElement | null;
	const confirmFeedback = document.getElementById('nda-confirm-feedback');

	confirmBtn?.addEventListener('click', async () => {
		if (!confirmBtn) return;
		const lock = lockButton(confirmBtn, { busyLabel: 'Vérification…' });
		if (!lock.locked) return;
		if (confirmFeedback) confirmFeedback.textContent = '';
		try {
			const result = await syncNdaSignature();
			if (result.signed) {
				reloadAfterNdaSigned();
				return;
			}
			if (confirmFeedback) confirmFeedback.textContent = result.message;
		} catch {
			if (confirmFeedback) {
				confirmFeedback.textContent =
					'Impossible de vérifier la signature pour le moment. Réessaie dans quelques secondes.';
			}
		}
		lock.unlock();
	});

	const panel = document.getElementById('status-panel');
	if (panel?.dataset.poll === 'true') {
		const initialFingerprint = panel.dataset.fingerprint ?? '';
		const intervalMs = Number(panel.dataset.pollInterval) || 2000;
		const maxMs = Number(panel.dataset.pollMax) || 180_000;
		const startedAt = Date.now();
		let timer: ReturnType<typeof setTimeout> | undefined;
		let stopped = false;
		let inFlight = false;

		const stop = () => {
			stopped = true;
			if (timer !== undefined) clearTimeout(timer);
		};

		const schedule = () => {
			if (stopped) return;
			if (timer !== undefined) clearTimeout(timer);
			timer = setTimeout(() => {
				void tick();
			}, intervalMs);
		};

		const tick = async () => {
			if (stopped || inFlight) return;
			if (Date.now() - startedAt >= maxMs) {
				stop();
				return;
			}
			if (document.visibilityState === 'hidden') {
				schedule();
				return;
			}
			inFlight = true;
			try {
				const res = await fetch('/api/enrollment/status', {
					headers: { Accept: 'application/json' },
					credentials: 'same-origin',
				});
				if (res.ok) {
					const data = (await res.json()) as {
						collectionStatus?: string;
						contractStatus?: string;
						accessStatus?: string;
					};
					const next = `${data.collectionStatus ?? ''}|${data.contractStatus ?? ''}|${data.accessStatus ?? ''}`;
					if (next && next !== initialFingerprint) {
						stop();
						window.location.reload();
						return;
					}
				}
			} catch {
				// ignore transient network errors; keep polling until max
			} finally {
				inFlight = false;
			}
			schedule();
		};

		document.addEventListener('visibilitychange', () => {
			if (document.visibilityState === 'visible' && !stopped) {
				void tick();
			}
		});

		schedule();
	}
</script>
