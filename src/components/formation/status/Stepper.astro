---
const items: Array<{ title: string; text: string; logo?: string }> = [
	{
		title: 'Vous payez en ligne sur Stripe',
		text: 'Règlement sécurisé en une ou plusieurs fois via la plateforme de paiement Stripe.',
	},
	{
		title: 'Vous signez le contrat de confidentialité par e-mail',
		text: 'Signature électronique via le lien Yousign qui sera envoyé dès confirmation du paiement.',
	},
	{
		title: 'Vous recevez vos accès Teachizy',
		text: 'L’invitation Teachizy avec vos identifiants vous est envoyée dès que la signature est confirmée.',
		logo: '/icons/teachizy-mark.png',
	},
];
---

<ol class="stepper" aria-label="Parcours d'inscription">
	{
		items.map((item, index) => {
			const lastSpace = item.title.lastIndexOf(' ');
			const lead = item.logo && lastSpace > 0 ? item.title.slice(0, lastSpace + 1) : item.title;
			const tail = item.logo && lastSpace > 0 ? item.title.slice(lastSpace + 1) : null;

			return (
				<li class="stepper__item">
					<span class="stepper__index" aria-hidden="true">
						{String(index + 1).padStart(2, '0')}
					</span>
					<div class="stepper__body">
						<h3 class="stepper__title">
							<span class="sr-only">Étape {index + 1} — </span>
							{lead}
							{tail && item.logo ? (
								<span class="stepper__mark">
									{tail}
									<img src={item.logo} alt="" width="28" height="28" class="stepper__logo" />
								</span>
							) : null}
						</h3>
						<p class="stepper__text">{item.text}</p>
					</div>
				</li>
			);
		})
	}
</ol>

<style>
	.stepper {
		display: grid;
		gap: 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stepper__item {
		display: grid;
		grid-template-columns: 2.3rem minmax(0, 1fr);
		column-gap: 1rem;
		align-items: start;
	}

	.stepper__index {
		display: block;
		width: 2.3rem;
		font-family: var(--font-display);
		font-size: 1.35rem;
		line-height: 1.15;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
		color: var(--color-gold);
	}

	.stepper__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.125rem;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--color-ink);
		text-wrap: balance;
	}

	.stepper__mark {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		white-space: nowrap;
	}

	.stepper__logo {
		width: 1.35rem;
		height: 1.35rem;
		flex-shrink: 0;
		border-radius: 0.35rem;
		object-fit: cover;
	}

	.stepper__text {
		margin: 0.4rem 0 0;
		max-width: 38ch;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-ink-soft);
	}

	@media (min-width: 640px) {
		.stepper {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			column-gap: 2.5rem;
			row-gap: 0;
		}

		.stepper__item {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.85rem;
		}

		.stepper__index {
			width: auto;
			font-size: 1.75rem;
			line-height: 1;
		}

		.stepper__title {
			font-size: 1.25rem;
		}

		.stepper__logo {
			width: 1.5rem;
			height: 1.5rem;
		}

		.stepper__text {
			margin-top: 0.35rem;
			font-size: 0.9375rem;
		}
	}
</style>
