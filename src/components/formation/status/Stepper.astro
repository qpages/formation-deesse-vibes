---
const items: Array<{ title: string; text: string; logo?: string }> = [
	{
		title: 'Vous payez en ligne sur Stripe',
		text: 'Règlement sécurisé via la plateforme de paiement Stripe.',
	},
	{
		title: 'Vous signez l’accord par e-mail',
		text: 'Signature électronique de l’accord de confidentialité via Yousign, envoyée dès confirmation du paiement.',
	},
	{
		title: 'Vous recevez vos accès Teachizy',
		text: 'L’invitation Teachizy avec vos identifiants vous est envoyée dès que la signature est confirmée.',
		logo: '/icons/teachizy-mark.png',
	},
];
---

<ol class="grid gap-10 sm:grid-cols-3 sm:gap-12">
	{
		items.map((item, index) => {
			const lastSpace = item.title.lastIndexOf(' ');
			const lead = item.logo && lastSpace > 0 ? item.title.slice(0, lastSpace + 1) : item.title;
			const tail = item.logo && lastSpace > 0 ? item.title.slice(lastSpace + 1) : null;

			return (
				<li>
					<div class="grid grid-cols-[3rem_minmax(0,1fr)] items-start gap-x-4 gap-y-4">
						<span
							class="shrink-0 font-display text-[2.75rem] leading-none tracking-tight text-gold"
							aria-hidden="true"
						>
							{index + 1}
						</span>
						<h3 class="min-w-0 font-display text-xl leading-snug text-ink sm:text-2xl">
							{lead}
							{tail && item.logo ? (
								<span class="inline-flex items-center gap-1.5 whitespace-nowrap">
									{tail}
									<img
										src={item.logo}
										alt=""
										width="28"
										height="28"
										class="size-6 shrink-0 rounded-md object-cover sm:size-7"
									/>
								</span>
							) : null}
						</h3>
						<div class="col-span-2 border-t border-ink/12 pt-3">
							<p class="pl-16 text-sm leading-relaxed text-ink-soft">{item.text}</p>
						</div>
					</div>
				</li>
			);
		})
	}
</ol>
