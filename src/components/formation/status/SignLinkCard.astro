---
import Button from '../../ui/Button.astro';

interface Props {
	signUrl: string;
}

const { signUrl } = Astro.props;
---

<div class="space-y-2">
	<div class="flex flex-col gap-3 sm:flex-row sm:items-stretch">
		<div
			class="border-ink/12 focus-within:border-gold/50 flex min-w-0 flex-1 items-stretch overflow-hidden rounded-sm border transition"
		>
			<input
				id="nda-sign-url"
				type="text"
				readonly
				value={signUrl}
				class="text-ink-soft selection:bg-blush/25 min-w-0 flex-1 bg-transparent px-3.5 py-3 font-sans text-sm outline-none"
			/>
			<button
				id="copy-sign-url"
				type="button"
				class="border-ink/10 text-ink hover:bg-ink hover:text-mist shrink-0 border-l px-4 text-xs font-medium tracking-[0.12em] uppercase transition"
				data-copied="false"
			>
				<span data-copy-label>Copier</span>
			</button>
		</div>
		<Button
			href={signUrl}
			size="md"
			target="_blank"
			rel="noopener noreferrer"
			class="w-full shrink-0 sm:w-auto"
		>
			Signer mon accord
		</Button>
	</div>
	<p id="copy-sign-feedback" class="sr-only" aria-live="polite"></p>
</div>

<script>
	import { copyText } from '../../../lib/client/copy-text';

	const input = document.getElementById('nda-sign-url') as HTMLInputElement | null;
	const btn = document.getElementById('copy-sign-url');
	const label = btn?.querySelector<HTMLElement>('[data-copy-label]');
	const feedback = document.getElementById('copy-sign-feedback');

	async function copyUrl() {
		if (!input || !btn || !label) return;
		if ((await copyText(input.value)) !== 'copied') return;
		btn.dataset.copied = 'true';
		label.textContent = 'Copié';
		if (feedback) feedback.textContent = 'Lien copié dans le presse-papiers.';
		window.setTimeout(() => {
			btn.dataset.copied = 'false';
			label.textContent = 'Copier';
			if (feedback) feedback.textContent = '';
		}, 2000);
	}

	btn?.addEventListener('click', () => {
		void copyUrl();
	});
</script>
