---
import { getEnv } from '../../../lib/env';
import Button from '../../ui/Button.astro';

interface Props {
	src: string;
	email: string;
}

const { src, email } = Astro.props;
const apiBase = getEnv().DOCUSEAL_API_BASE;
const cdnBase = apiBase.includes('.com') ? 'https://cdn.docuseal.com' : 'https://cdn.docuseal.eu';
---

<div class="space-y-3" id="nda-docuseal-embed">
	<div id="nda-docuseal-form-area">
		<docuseal-form
			id="nda-docuseal-form"
			data-src={src}
			data-email={email}
			data-with-send-copy-button="false"
			data-with-download-button="false"></docuseal-form>
	</div>

	<div id="nda-docuseal-actions" class="space-y-3">
		<p id="nda-docuseal-message" class="text-ink-soft text-sm">
			Signez directement ci-dessus : la page se met à jour automatiquement après signature. En cas
			de retard, cliquez sur Actualiser pour forcer la vérification.
		</p>
		<Button
			id="nda-docuseal-refresh"
			type="button"
			size="md"
			variant="primary"
			class="w-full whitespace-nowrap sm:w-auto"
		>
			Actualiser
		</Button>
		<p id="nda-docuseal-refresh-feedback" class="text-ink-soft text-sm" aria-live="polite"></p>
	</div>
</div>

<script is:inline src={`${cdnBase}/js/form.js`}></script>
<script>
	import { lockButton } from '../../../lib/client/lock-button';
	import { refreshEnrollmentAfterNdaSigned } from '../../../lib/client/enrollment-status-client';
	import { requestNdaSignatureRefresh } from '../../../lib/client/refresh-nda-signature';

	const formArea = document.getElementById('nda-docuseal-form-area');
	const form = document.getElementById('nda-docuseal-form');
	const message = document.getElementById('nda-docuseal-message');
	const refreshBtn = document.getElementById('nda-docuseal-refresh') as HTMLButtonElement | null;
	const refreshFeedback = document.getElementById('nda-docuseal-refresh-feedback');

	const SUBMITTED_MARKERS = [
		'déjà été soumis',
		'already been submitted',
		'already submitted',
		'form has already been submitted',
		'document signé',
		'document signed',
		'signed successfully',
		'signature complete',
		'signature completed',
		'merci pour votre signature',
		'thank you for signing',
	];

	const PENDING_MESSAGE = 'Signature détectée. Mise à jour en cours…';
	const FALLBACK_MESSAGE =
		'Signature détectée. Si la page ne se met pas à jour sous quelques secondes, cliquez sur Actualiser.';
	const SYNC_RETRY_INTERVAL_MS = 5_000;
	const SYNC_RETRY_MAX_MS = 120_000;

	let pendingSync = false;
	let syncRetryTimer: ReturnType<typeof setInterval> | undefined;
	let syncRetryStartedAt = 0;

	function isCompletedDetail(detail: unknown): boolean {
		if (!detail || typeof detail !== 'object') return false;
		const data = detail as Record<string, unknown>;
		const submission =
			data.submission && typeof data.submission === 'object'
				? (data.submission as Record<string, unknown>)
				: null;
		const status = String(data.status ?? submission?.status ?? '')
			.toLowerCase()
			.trim();
		if (status === 'completed') return true;
		return Boolean(data.completed_at ?? submission?.completed_at);
	}

	function collectVisibleText(root: ParentNode): string {
		const parts: string[] = [];
		const gather = (node: ParentNode) => {
			parts.push((node as HTMLElement).textContent?.toLowerCase() ?? '');
			if (node instanceof Element) {
				if (node.shadowRoot) gather(node.shadowRoot);
				for (const child of node.children) gather(child);
			}
		};
		gather(root);
		return parts.join(' ');
	}

	function textIndicatesSubmitted(root: ParentNode): boolean {
		const text = collectVisibleText(root);
		return SUBMITTED_MARKERS.some((marker) => text.includes(marker));
	}

	function showPendingSync() {
		if (pendingSync) return;
		pendingSync = true;
		formArea?.classList.add('hidden');
		if (message) message.textContent = PENDING_MESSAGE;
	}

	async function refreshNdaSignature(): Promise<boolean> {
		const result = await requestNdaSignatureRefresh();
		if (result.signed) {
			await refreshEnrollmentAfterNdaSigned();
			return true;
		}
		if (refreshFeedback) refreshFeedback.textContent = result.message;
		return false;
	}

	function stopSyncRetries() {
		if (syncRetryTimer !== undefined) {
			clearInterval(syncRetryTimer);
			syncRetryTimer = undefined;
		}
	}

	async function attemptSyncRetry() {
		if (Date.now() - syncRetryStartedAt >= SYNC_RETRY_MAX_MS) {
			stopSyncRetries();
			if (message) message.textContent = FALLBACK_MESSAGE;
			return;
		}
		try {
			const synced = await refreshNdaSignature();
			if (synced) {
				stopSyncRetries();
				return;
			}
		} catch {
			// keep retrying until timeout
		}
	}

	function startSyncRetries() {
		stopSyncRetries();
		syncRetryStartedAt = Date.now();
		void attemptSyncRetry();
		syncRetryTimer = setInterval(() => void attemptSyncRetry(), SYNC_RETRY_INTERVAL_MS);
	}

	function onSignatureDetected() {
		showPendingSync();
		startSyncRetries();
	}

	function observeSubmittedState() {
		if (!form) return;

		const check = () => {
			if (pendingSync) return;
			if (textIndicatesSubmitted(form)) {
				onSignatureDetected();
				observer.disconnect();
			}
		};

		const observer = new MutationObserver(check);
		observer.observe(form, { childList: true, subtree: true, characterData: true });
		check();
	}

	form?.addEventListener('load', (event) => {
		if (isCompletedDetail((event as CustomEvent).detail)) {
			onSignatureDetected();
		}
	});

	form?.addEventListener('completed', (event) => {
		const detail = (event as CustomEvent).detail;
		if (detail != null && typeof detail === 'object' && !isCompletedDetail(detail)) {
			const status = String((detail as Record<string, unknown>).status ?? '').toLowerCase();
			if (status && status !== 'completed') return;
		}
		onSignatureDetected();
		if (typeof window.toast === 'function') {
			window.toast('Signature envoyée. Mise à jour en cours…', 'success');
		}
	});

	refreshBtn?.addEventListener('click', async () => {
		if (!refreshBtn) return;
		const lock = lockButton(refreshBtn, { busyLabel: 'Actualisation…' });
		if (!lock.locked) return;
		if (refreshFeedback) refreshFeedback.textContent = '';
		try {
			await refreshNdaSignature();
		} catch {
			if (refreshFeedback) {
				refreshFeedback.textContent =
					'Impossible de vérifier la signature pour le moment. Réessayez dans quelques secondes.';
			}
		}
		lock.unlock();
	});

	observeSubmittedState();
</script>
