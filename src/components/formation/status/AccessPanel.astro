---
import type { EnrollmentWithUser } from '../../../lib/services/enrollment';
import type { PaidInvoiceLink } from '../../../lib/services/payments';
import { getEnv } from '../../../lib/env';
import { whatsappHelpHref } from '../../../lib/whatsapp';
import CheckoutForm from '../landing/CheckoutForm.astro';
import MagicLinkForm from './MagicLinkForm.astro';
import StatusPanel from './StatusPanel.astro';

const env = getEnv();
const adminContactEmail = env.PUBLIC_ADMIN_CONTACT_EMAIL;
const adminContactHref =
	whatsappHelpHref(env.PUBLIC_WHATSAPP_NUMBER) ??
	`mailto:${adminContactEmail}?subject=${encodeURIComponent('Formation Matrice Évolution')}`;
const adminContactExternal = adminContactHref.startsWith('https://');

interface Props {
	showFunnel: boolean;
	enrollment: EnrollmentWithUser | null;
	ndaSignUrl?: string | null;
	invoiceLinks?: PaidInvoiceLink[];
	flash?: string | null;
	checkoutCancel?: boolean;
	magicLinkFailed?: boolean;
	defaultTab?: 'nouveau' | 'retrouver';
}

const {
	showFunnel,
	enrollment,
	ndaSignUrl = null,
	invoiceLinks = [],
	flash = null,
	checkoutCancel = false,
	magicLinkFailed = false,
	defaultTab = 'nouveau',
} = Astro.props;

const activeTab = magicLinkFailed ? 'retrouver' : defaultTab;
const funnelFlash = showFunnel ? flash : null;
const trackingFlash = showFunnel ? null : flash;
---

{
	showFunnel ? (
		<div id="access-funnel">
			<div
				class="inline-flex rounded-sm border border-ink/15 p-1"
				role="tablist"
				aria-label="Choisir votre parcours"
			>
					<button
						type="button"
						role="tab"
						id="tab-nouveau"
						aria-controls="panel-nouveau"
						aria-selected={activeTab === 'nouveau' ? 'true' : 'false'}
						data-access-tab="nouveau"
						class:list={[
							'access-tab h-10 px-4 text-sm font-medium transition',
							activeTab === 'nouveau'
								? 'bg-ink text-mist'
								: 'text-ink-soft',
						]}
					>
						Nouveau
					</button>
					<button
						type="button"
						role="tab"
						id="tab-retrouver"
						aria-controls="panel-retrouver"
						aria-selected={activeTab === 'retrouver' ? 'true' : 'false'}
						data-access-tab="retrouver"
						class:list={[
							'access-tab h-10 px-4 text-sm font-medium transition',
							activeTab === 'retrouver'
								? 'bg-ink text-mist'
								: 'text-ink-soft',
						]}
					>
						Déjà inscrit·e
					</button>
				</div>

				<div
					id="panel-nouveau"
					role="tabpanel"
					aria-labelledby="tab-nouveau"
					class:list={['mt-6', activeTab !== 'nouveau' && 'hidden']}
					data-access-panel="nouveau"
				>
					<p class="mb-5 text-sm text-ink-soft">
						Renseignez vos informations, puis réglez en toute sécurité via la plateforme de paiement Stripe.
					</p>
					<CheckoutForm />
				</div>

				<div
					id="panel-retrouver"
					role="tabpanel"
					aria-labelledby="tab-retrouver"
					class:list={['mt-6', activeTab !== 'retrouver' && 'hidden']}
					data-access-panel="retrouver"
				>
					<p class="mb-1 text-sm text-ink-soft">
						Saisissez l’e-mail utilisé lors du paiement pour retrouver votre inscription.
					</p>
					<MagicLinkForm />
				</div>
		</div>
	) : (
		<div id="access-tracking" class="max-w-3xl">
			{enrollment && (
				<div class="space-y-8">
					<div>
						<StatusPanel
							enrollment={enrollment}
							ndaSignUrl={ndaSignUrl}
						/>
					</div>

					<div>
						<p class="mb-3 text-[10px] uppercase tracking-[0.12em] text-ink/40">Compte</p>
						<div class="space-y-4">
							<p class="text-sm text-ink-soft">
								Connecté·e en tant que{' '}
								<span class="font-medium text-ink">
									{enrollment.user.firstName} {enrollment.user.lastName}
								</span>
								<span class="text-ink/40"> · </span>
								{enrollment.user.email}
							</p>
							<p class="text-sm text-ink-soft">
								<button
									type="button"
									id="clear-session"
									class="underline-offset-4 hover:text-ink hover:underline"
								>
									Se déconnecter
								</button>
								<span class="text-ink/25" aria-hidden="true">
									{' '}
									·{' '}
								</span>
								<a
									href={adminContactHref}
									class="underline-offset-4 hover:text-ink hover:underline"
									target={adminContactExternal ? '_blank' : undefined}
									rel={adminContactExternal ? 'noopener noreferrer' : undefined}
								>
									Contacter un administrateur
								</a>
							</p>
						</div>
					</div>

					{invoiceLinks.length > 0 && (
						<div>
							<p class="mb-3 text-[10px] uppercase tracking-[0.12em] text-ink/40">Factures</p>
							<ul class="space-y-3">
								{invoiceLinks.map((invoice) => (
									<li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
										<p class="text-sm text-ink">{invoice.label}</p>
										<div class="flex shrink-0 items-center gap-x-3 text-sm">
											{invoice.viewUrl ? (
												<a
													href={invoice.viewUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="text-ink-soft underline-offset-4 hover:text-ink hover:underline"
												>
													Voir
												</a>
											) : null}
											{invoice.downloadUrl ? (
												<a
													href={invoice.downloadUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="text-ink-soft underline-offset-4 hover:text-ink hover:underline"
												>
													Télécharger
												</a>
											) : null}
										</div>
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
			)}
		</div>
	)
}

<script
	define:vars={{
		funnelFlash,
		trackingFlash,
		checkoutCancel,
		magicLinkFailed,
	}}
>
	const tabs = document.querySelectorAll('[data-access-tab]');
	const panels = document.querySelectorAll('[data-access-panel]');

	function setTab(name) {
		tabs.forEach((tab) => {
			const active = tab.dataset.accessTab === name;
			tab.setAttribute('aria-selected', active ? 'true' : 'false');
			tab.classList.toggle('bg-ink', active);
			tab.classList.toggle('text-mist', active);
			tab.classList.toggle('text-ink-soft', !active);
		});
		panels.forEach((panel) => {
			panel.classList.toggle('hidden', panel.dataset.accessPanel !== name);
		});
	}

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const name = tab.dataset.accessTab;
			if (name) setTab(name);
		});
	});

	const clearBtn = document.getElementById('clear-session');
	clearBtn?.addEventListener('click', async () => {
		clearBtn.setAttribute('disabled', 'true');
		try {
			const response = await fetch('/api/session/clear', { method: 'POST' });
			if (!response.ok) throw new Error('Session impossible à réinitialiser');
			window.location.assign('/');
		} catch {
			clearBtn.removeAttribute('disabled');
		}
	});

	function showPageToasts(attempt = 0) {
		if (typeof window.toast !== 'function') {
			if (attempt < 20) window.setTimeout(() => showPageToasts(attempt + 1), 25);
			return;
		}
		if (funnelFlash) {
			window.toast(funnelFlash, magicLinkFailed ? 'error' : 'success');
		}
		if (trackingFlash) {
			window.toast(trackingFlash, 'success');
		}
		if (checkoutCancel) {
			window.toast('Paiement annulé. Vous pouvez reprendre quand vous voulez.', 'info');
		}
	}

	if (funnelFlash || trackingFlash || checkoutCancel) {
		showPageToasts();
	}

	const url = new URL(window.location.href);
	if (url.searchParams.has('connected') || url.searchParams.has('link')) {
		url.searchParams.delete('connected');
		url.searchParams.delete('link');
		const next = `${url.pathname}${url.search}${url.hash}`;
		window.history.replaceState({}, '', next);
	}
</script>
