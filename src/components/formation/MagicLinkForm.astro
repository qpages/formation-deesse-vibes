---
import Alert from '../ui/Alert.astro';
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Input from '../ui/Input.astro';
---

<form id="magic-form" class="mt-6 max-w-md space-y-4">
	<FormField label="Votre e-mail d’inscription" name="magicEmail">
		<Input type="email" name="magicEmail" required autocomplete="email" />
	</FormField>
	<Button type="submit" variant="secondary" id="magic-submit">Recevoir mon lien</Button>
	<div id="magic-feedback" class="hidden">
		<Alert variant="info"><span id="magic-feedback-text"></span></Alert>
	</div>
</form>

<script>
	const form = document.getElementById('magic-form') as HTMLFormElement | null;
	const submit = document.getElementById('magic-submit') as HTMLButtonElement | null;
	const box = document.getElementById('magic-feedback');
	const text = document.getElementById('magic-feedback-text');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form || !submit) return;
		submit.disabled = true;
		const email = String(new FormData(form).get('magicEmail') ?? '');
		try {
			const res = await fetch('/api/magic-link/request', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			const json = await res.json();
			if (text) text.textContent = json.message || json.error || 'Demande envoyée.';
			box?.classList.remove('hidden');
		} catch {
			if (text) text.textContent = 'Impossible d’envoyer le lien pour le moment.';
			box?.classList.remove('hidden');
		} finally {
			submit.disabled = false;
		}
	});
</script>
