---
import Alert from '../ui/Alert.astro';
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Input from '../ui/Input.astro';
---

<form id="magic-form" class="max-w-md space-y-4">
	<FormField label="Votre e-mail d’inscription" name="magicEmail">
		<Input type="email" name="magicEmail" required autocomplete="email" />
	</FormField>
	<Button type="submit" variant="secondary" id="magic-submit">Retrouver mon inscription</Button>
	<div id="magic-feedback" class="hidden">
		<Alert variant="error"><span id="magic-feedback-text"></span></Alert>
	</div>
</form>

<script>
	const form = document.getElementById('magic-form') as HTMLFormElement | null;
	const submit = document.getElementById('magic-submit') as HTMLButtonElement | null;
	const box = document.getElementById('magic-feedback');
	const text = document.getElementById('magic-feedback-text');

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form || !submit) return;
		submit.disabled = true;
		box?.classList.add('hidden');
		const email = String(new FormData(form).get('magicEmail') ?? '');
		try {
			const res = await fetch('/api/session/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			const json = await res.json();
			if (!res.ok) {
				if (text) text.textContent = json.error || 'Connexion impossible.';
				box?.classList.remove('hidden');
				return;
			}
			window.location.assign('/');
		} catch {
			if (text) text.textContent = 'Impossible de vous connecter pour le moment.';
			box?.classList.remove('hidden');
		} finally {
			submit.disabled = false;
		}
	});
</script>
