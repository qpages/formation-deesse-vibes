---
import type { Enrollment } from '../../generated/prisma/client';
import type { StepKey, StepState } from '../../lib/status';
import Alert from '../ui/Alert.astro';
import AccessSteps from './AccessSteps.astro';
import CheckoutForm from './CheckoutForm.astro';
import ContactAdmin from './ContactAdmin.astro';
import MagicLinkForm from './MagicLinkForm.astro';
import StatusPanel from './StatusPanel.astro';
import Stepper from './Stepper.astro';

interface Props {
	showFunnel: boolean;
	enrollment: Enrollment | null;
	steps: Record<StepKey, StepState>;
	ndaSignUrl?: string | null;
	flash?: string | null;
	checkoutCancel?: boolean;
	magicLinkFailed?: boolean;
	defaultTab?: 'nouveau' | 'retrouver';
}

const {
	showFunnel,
	enrollment,
	steps,
	ndaSignUrl = null,
	flash = null,
	checkoutCancel = false,
	magicLinkFailed = false,
	defaultTab = 'nouveau',
} = Astro.props;

const activeTab = magicLinkFailed ? 'retrouver' : defaultTab;
---

{
	showFunnel ? (
		<div id="access-funnel" class="space-y-8">
			<div>
				<AccessSteps />
			</div>

			{(flash || checkoutCancel) && (
				<div class="space-y-3">
					{flash && (
						<Alert variant={magicLinkFailed ? 'error' : 'success'}>{flash}</Alert>
					)}
					{checkoutCancel && (
						<Alert variant="info">Paiement annulé. Vous pouvez reprendre quand vous voulez.</Alert>
					)}
				</div>
			)}

			<div>
				<h3 class="mb-5 font-display text-3xl text-ink">Démarrer ma formation</h3>
				<div
					class="inline-flex rounded-sm border border-ink/15 p-1"
					role="tablist"
					aria-label="Choisir votre parcours"
				>
					<button
						type="button"
						role="tab"
						id="tab-nouveau"
						aria-controls="panel-nouveau"
						aria-selected={activeTab === 'nouveau' ? 'true' : 'false'}
						data-access-tab="nouveau"
						class:list={[
							'access-tab h-10 px-4 text-sm font-medium transition',
							activeTab === 'nouveau'
								? 'bg-ink text-mist'
								: 'text-ink-soft hover:text-ink',
						]}
					>
						Nouveau
					</button>
					<button
						type="button"
						role="tab"
						id="tab-retrouver"
						aria-controls="panel-retrouver"
						aria-selected={activeTab === 'retrouver' ? 'true' : 'false'}
						data-access-tab="retrouver"
						class:list={[
							'access-tab h-10 px-4 text-sm font-medium transition',
							activeTab === 'retrouver'
								? 'bg-ink text-mist'
								: 'text-ink-soft hover:text-ink',
						]}
					>
						Déjà inscrit·e
					</button>
				</div>

				<div
					id="panel-nouveau"
					role="tabpanel"
					aria-labelledby="tab-nouveau"
					class:list={['mt-6', activeTab !== 'nouveau' && 'hidden']}
					data-access-panel="nouveau"
				>
					<p class="mb-5 text-sm text-ink-soft">
						Renseignez vos informations, puis réglez en toute sécurité via la plateforme de paiement Stripe.
					</p>
					<CheckoutForm />
				</div>

				<div
					id="panel-retrouver"
					role="tabpanel"
					aria-labelledby="tab-retrouver"
					class:list={['mt-6', activeTab !== 'retrouver' && 'hidden']}
					data-access-panel="retrouver"
				>
					<p class="mb-1 text-sm text-ink-soft">
						Saisissez l’e-mail utilisé lors du paiement pour retrouver votre inscription.
					</p>
					<MagicLinkForm />
				</div>
			</div>
		</div>
	) : (
		<div id="access-tracking" class="space-y-8">
			{enrollment && (
				<>
					<div>
						<Stepper steps={steps} />
					</div>

					<div class="border-t border-ink/10 pt-8">
						<StatusPanel enrollment={enrollment} ndaSignUrl={ndaSignUrl} flash={flash} />
						{enrollment.status === 'teachizy_envoye' ? (
							<div class="mt-6">
								<p class="text-xs text-ink-soft">
									Session :{' '}
									<span class="text-ink/80">
										{enrollment.firstName} {enrollment.lastName}
									</span>
									{' · '}
									<button
										type="button"
										id="clear-session"
										class="underline-offset-4 hover:text-ink hover:underline"
									>
										Ce n’est pas moi
									</button>
									{' · '}
									<ContactAdmin label="Aide" />
								</p>
							</div>
						) : (
							<div class="mt-6">
								<p class="text-sm text-ink-soft">
									Connecté·e en tant que{' '}
									<span class="font-medium text-ink">
										{enrollment.firstName} {enrollment.lastName}
									</span>{' '}
									({enrollment.email})
								</p>
								<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
									<button
										type="button"
										id="clear-session"
										class="underline-offset-4 hover:text-ink hover:underline"
									>
										Ce n’est pas moi
									</button>
									<span class="text-ink/25" aria-hidden="true">
										·
									</span>
									<ContactAdmin />
								</div>
							</div>
						)}
					</div>
				</>
			)}
		</div>
	)
}

<script>
	const tabs = document.querySelectorAll<HTMLButtonElement>('[data-access-tab]');
	const panels = document.querySelectorAll<HTMLElement>('[data-access-panel]');

	function setTab(name: string) {
		tabs.forEach((tab) => {
			const active = tab.dataset.accessTab === name;
			tab.setAttribute('aria-selected', active ? 'true' : 'false');
			tab.classList.toggle('bg-ink', active);
			tab.classList.toggle('text-mist', active);
			tab.classList.toggle('text-ink-soft', !active);
		});
		panels.forEach((panel) => {
			panel.classList.toggle('hidden', panel.dataset.accessPanel !== name);
		});
	}

	tabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const name = tab.dataset.accessTab;
			if (name) setTab(name);
		});
	});

	const clearBtn = document.getElementById('clear-session');
	clearBtn?.addEventListener('click', async () => {
		clearBtn.setAttribute('disabled', 'true');
		try {
			await fetch('/api/session/clear', { method: 'POST' });
			window.location.assign('/');
		} catch {
			clearBtn.removeAttribute('disabled');
		}
	});
</script>
