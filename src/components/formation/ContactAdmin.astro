---
import { getEnv } from '../../lib/env';

interface Props {
	label?: string;
}

const { label = 'Contacter un administrateur' } = Astro.props;
const email = getEnv().PUBLIC_ADMIN_CONTACT_EMAIL;
---

<a
	href={`mailto:${email}?subject=${encodeURIComponent('Formation Matrice Évolution')}`}
	class="text-ink-soft underline-offset-4 hover:text-ink hover:underline"
>
	{label}
</a>
