---
import Button from '../ui/Button.astro';
import { getEnv } from '../../lib/env';

const email = getEnv().PUBLIC_ADMIN_CONTACT_EMAIL;
---

<div class="mt-8">
	<p class="mb-3 text-sm text-ink-soft">Besoin d’aide sur votre parcours ?</p>
	<Button href={`mailto:${email}?subject=Formation%20Matrice%20Évolution`} variant="secondary" size="sm">
		Contacter un administrateur
	</Button>
</div>
