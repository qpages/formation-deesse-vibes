---
const steps = [
	{
		title: 'Vous payez en ligne',
		text: 'Règlement sécurisé de 320 € TTC via Stripe.',
	},
	{
		title: 'Vous signez l’accord par e-mail',
		text: 'L’accord de confidentialité arrive après le paiement.',
	},
	{
		title: 'Vous recevez vos accès Teachizy',
		text: 'L’invitation est envoyée dès que la signature est confirmée.',
	},
];
---

<ol class="access-steps grid gap-5 sm:grid-cols-3 sm:gap-6">
	{
		steps.map((step, index) => (
			<li class="relative grid grid-cols-[2.5rem_1fr] gap-3 sm:block">
				<span class="flex h-10 w-10 items-center justify-center rounded-full border border-gold/45 font-display text-xl text-ink">
					{index + 1}
				</span>
				<div class="pt-1 sm:mt-4 sm:pt-0">
					<h3 class="font-display text-xl leading-snug text-ink sm:text-2xl">{step.title}</h3>
					<p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{step.text}</p>
				</div>
			</li>
		))
	}
</ol>
