---
import Button from '../../ui/Button.astro';
import FormField from '../../ui/FormField.astro';
import Input from '../../ui/Input.astro';
import { resolveSignatureConsentCopy } from '../../../lib/signature/helpers';
import PaymentPlanSelector from './PaymentPlanSelector.astro';

interface Props {
	lockedEmail?: string;
}

const { lockedEmail } = Astro.props;
const consentNdaCopy = resolveSignatureConsentCopy();
---

<form id="checkout-form" class="space-y-5" novalidate>
	<div class="grid gap-5 sm:grid-cols-2">
		<FormField label="Prénom" name="firstName">
			<Input name="firstName" required autocomplete="given-name" placeholder="Camille" />
		</FormField>
		<FormField label="Nom" name="lastName">
			<Input name="lastName" required autocomplete="family-name" placeholder="Martin" />
		</FormField>
	</div>

	<FormField label="E-mail" name="email">
		<Input
			type="email"
			name="email"
			required
			autocomplete="email"
			placeholder="camille.martin@email.com"
			value={lockedEmail}
		/>
	</FormField>

	<PaymentPlanSelector />

	<div class="border-ink/10 text-ink-soft space-y-3 border-t pt-5 text-sm">
		<label class="flex gap-3">
			<input type="checkbox" name="consentLegal" value="true" required class="mt-1" />
			<span>
				J’accepte les{' '}
				<a href="/cgv" class="hover:text-ink underline underline-offset-2"
					>conditions générales de vente</a
				>
				{' '}et la{' '}
				<a href="/confidentialite" class="hover:text-ink underline underline-offset-2"
					>politique de confidentialité</a
				>.
			</span>
		</label>
		<label class="flex gap-3">
			<input type="checkbox" name="consentWithdrawalWaiver" value="true" required class="mt-1" />
			<span>
				Je demande l’accès immédiat à la formation dès que les conditions sont remplies (paiement et
				signature du contrat de confidentialité) et je reconnais perdre mon{' '}
				<a href="/cgv#retractation" class="hover:text-ink underline underline-offset-2"
					>droit de rétractation</a
				>{' '}
				une fois l’accès Teachizy ouvert, conformément à l’article L221-28 du Code de la consommation.
			</span>
		</label>
		<label class="flex gap-3">
			<input type="checkbox" name="consentNda" value="true" required class="mt-1" />
			<span>{consentNdaCopy}</span>
		</label>
	</div>

	<Button type="submit" size="md" class="w-full sm:w-auto" id="checkout-submit">
		Je m’inscris
	</Button>
</form>

<script>
	import { lockFormSubmit } from '../../../lib/client/lock-submit';

	const form = document.getElementById('checkout-form') as HTMLFormElement | null;

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!form) return;
		const lock = lockFormSubmit(form, { busyLabel: 'Redirection…' });
		if (!lock.locked) return;

		const data = new FormData(form);
		const consentLegal = data.get('consentLegal') === 'true';
		const payload = {
			firstName: String(data.get('firstName') ?? ''),
			lastName: String(data.get('lastName') ?? ''),
			email: String(data.get('email') ?? ''),
			paymentPlan: String(data.get('paymentPlan') ?? ''),
			consentCgv: consentLegal,
			consentNda: data.get('consentNda') === 'true',
			consentPrivacy: consentLegal,
			consentWithdrawalWaiver: data.get('consentWithdrawalWaiver') === 'true',
		};

		try {
			const res = await fetch('/api/checkout', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const json = await res.json();
			if (!res.ok) throw new Error(json.error || 'Erreur de paiement');
			window.location.href = json.url;
		} catch (error) {
			window.toast?.(error instanceof Error ? error.message : 'Une erreur est survenue.', 'error');
			lock.unlock();
		}
	});
</script>
