---
import Button from '../../ui/Button.astro';
import { getEnv } from '../../../lib/env';
import { whatsappHelpHref } from '../../../lib/whatsapp';

const env = getEnv();
const adminEmail = env.PUBLIC_ADMIN_CONTACT_EMAIL;
const mailtoHref = `mailto:${adminEmail}?subject=${encodeURIComponent('Question — Formation Matrice Évolution')}`;
const whatsappHref = whatsappHelpHref(env.PUBLIC_WHATSAPP_NUMBER);

const items: {
	q: string;
	a: string;
	image?: { src: string; alt: string };
}[] = [
	{
		q: 'Dois-je créer un compte ?',
		a: 'Non. Votre e-mail de paiement suffit. Pour revenir plus tard, saisissez-le dans « Déjà inscrit·e ».',
	},
	{
		q: 'Quand vais-je recevoir mes accès Teachizy ?',
		a: 'Dès la confirmation du paiement et de la signature de l’accord de confidentialité.',
	},
	{
		q: 'Je ne retrouve pas l’email Teachizy, comment faire ?',
		a: 'Ouvrez la <a href="https://jsmatriceacademy.teachizy.fr" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-ink">page de connexion Teachizy</a>, saisissez votre adresse e-mail, puis cliquez sur <strong>Mot de passe oublié</strong>. Vous recevrez un nouveau lien pour définir votre mot de passe et accéder à la formation.',
		image: {
			src: '/images/teachizy-mot-de-passe-oublie.jpg',
			alt: 'Page de connexion Teachizy avec le lien Mot de passe oublié sous le bouton Se connecter',
		},
	},
	{
		q: 'J’ai payé mais je ne reçois pas de lien pour signer',
		a: `Pas d’inquiétude. Vérifiez d’abord vos spams, puis contactez un administrateur à <a href="mailto:${adminEmail}?subject=Lien%20de%20signature%20NDA%20manquant" class="underline underline-offset-2 hover:text-ink">${adminEmail}</a>, on débloque ça rapidement.`,
	},
	{
		q: 'Que se passe-t-il si je ne signe pas le NDA ?',
		a: 'Sans signature, vous ne pouvez pas accéder à la formation.',
	},
];
---

<div>
	<div class="divide-ink/10 divide-y">
		{
			items.map((item) => (
				<details class="group py-5">
					<summary class="font-display text-ink cursor-pointer list-none text-2xl marker:content-none [&::-webkit-details-marker]:hidden">
						<span class="flex items-center justify-between gap-4">
							{item.q}
							<span class="text-gold transition group-open:rotate-45">+</span>
						</span>
					</summary>
					<p
						class="text-ink-soft mt-3 max-w-2xl text-sm leading-relaxed sm:text-base"
						set:html={item.a}
					/>
					{item.image && (
						<img
							src={item.image.src}
							alt={item.image.alt}
							class="border-ink/10 bg-mist mt-4 h-auto w-full max-w-2xl overflow-hidden rounded-sm border"
							loading="lazy"
							decoding="async"
						/>
					)}
				</details>
			))
		}
	</div>

	<div class="border-ink/10 mt-8 flex flex-wrap items-center gap-3 border-t pt-8 sm:mt-10">
		<Button href={mailtoHref} variant="primary" size="md"> Contacter par e-mail </Button>
		{
			whatsappHref && (
				<Button
					href={whatsappHref}
					variant="secondary"
					size="md"
					target="_blank"
					rel="noopener noreferrer"
					class="border-[#1f8a4c]/30 text-[#1f8a4c] hover:border-[#1f8a4c]/50 hover:bg-[#1f8a4c]/8"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="currentColor"
						class="size-5 shrink-0"
						aria-hidden="true"
					>
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
					</svg>
					Contacter sur WhatsApp
				</Button>
			)
		}
	</div>
</div>
