{
  "name": "formation-deesse-vibes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:4321/api/inngest",
    "webhook:yousign": "ngrok http 4321",
    "webhook:stripe": "stripe listen --forward-to localhost:4321/api/webhooks/stripe",
    "build": "prisma generate && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "stop": "astro dev stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/boot-check.mjs",
    "check:env:prod": "node scripts/boot-check.mjs --prod",
    "check:tailwind": "node scripts/check-canonical-classes.mjs",
    "teachizy:list-trainings": "node scripts/list-teachizy-trainings.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/vercel": "^11.0.5",
    "@pheralb/toast": "^1.0.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "inngest": "^4.13.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.0",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.9.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
