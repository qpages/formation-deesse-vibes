{
	"name": "formation-deesse-vibes",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:host": "astro dev --host",
		"dev:inngest": "npx inngest-cli@latest dev -u http://localhost:4321/api/inngest",
		"webhook:signature": "ngrok http 4321",
		"webhook:stripe": "stripe listen --forward-to localhost:4321/api/webhooks/stripe",
		"build": "prisma generate && prisma migrate deploy && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"stop": "astro dev stop",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"check": "astro check",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"ci:local": "node scripts/ci-local.mjs",
		"test:e2e": "playwright test",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:install": "playwright install chromium",
		"check:env": "node scripts/boot-check.mjs",
		"check:env:prod": "node scripts/boot-check.mjs --prod",
		"env:push:prod": "node scripts/vercel-env-push-prod.mjs",
		"check:tailwind": "node scripts/check-canonical-classes.mjs",
		"teachizy:list-trainings": "node scripts/list-teachizy-trainings.mjs",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:generate": "prisma generate",
		"db:validate": "prisma validate",
		"db:studio": "prisma studio",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"postinstall": "prisma generate",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/vercel": "^11.0.5",
		"@prisma/adapter-pg": "^7.9.0",
		"@prisma/client": "^7.9.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"inngest": "^4.13.0",
		"jose": "^6.2.4",
		"pg": "^8.22.0",
		"stripe": "^22.3.2",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@types/pg": "^8.20.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.1.0",
		"globals": "^17.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"prisma": "^7.9.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,astro}": "prettier --write"
	}
}
